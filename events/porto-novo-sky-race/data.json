o completo est\u00e3o dispon\u00edveis na plataforma TurresEvents (www.turresevents.com).\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":51690,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,708,22,497,498],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-51689","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-porto-novo-torres-vedras","event_type-caminhada","event_type-skyrunning","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/06\/Pope484nl3145.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51689","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=51689"}],"version-history":[{"count":3,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51689\/revisions"}],"predecessor-version":[{"id":65848,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51689\/revisions\/65848"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/51690"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=51689"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/tags?post=5168