{"id":41445,"date":"2025-04-16T14:57:44","date_gmt":"2025-04-16T13:57:44","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-loures-odivelas-2025\/"},"modified":"2026-08-21T08:55:50","modified_gmt":"2026-08-21T07:55:50","slug":"meia-maratona-loures-odivelas-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-loures-odivelas-2025\/","title":{"rendered":"Meia Maratona Loures Odivelas 2025"},"content":{"rendered":"<div class=\"pr-expired-notice\" style=\"background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(30, 41, 59, 0.6) 100%); border: 1px solid rgba(139, 92, 246, 0.35); border-radius: 16px; padding: 18px 24px; margin-bottom: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;\"><div style=\"display: flex; align-items: center; gap: 12px; flex: 1; min-width: 260px;\"><span style=\"font-size: 24px;\">\ud83c\udfc3\u200d\u2642\ufe0f<\/span><div><strong style=\"color: #FFFFFF; font-size: 15px; font-family: 'Outfit', sans-serif;\">Esta edi\u00e7\u00e3o j\u00e1 decorreu.<\/strong><p style=\"font-size: 13.5px; color: #CBD5E1; margin: 2px 0 0 0;\">Consulta os resultados desta prova abaixo ou acede a todos os detalhes da edi\u00e7\u00e3o atual.<\/p><\/div><\/div><a href=\"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-loures-odivelas\/\" style=\"background: #8B5CF6 !important; color: #FFFFFF !important; font-weight: 700 !important; font-size: 13.5px !important; text-decoration: none !important; padding: 11px 22px !important; border-radius: 10px !important; white-space: nowrap !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; height: 42px !important; margin: 0 !important; border: none !important; line-height: 1 !important; box-shadow: 0 4px 14px rgba(139, 92, 246, 0.4) !important;\">Ver Edi\u00e7\u00e3o Atual &rarr;<\/a><\/div>\n\n\n<p class=\"wp-block-paragraph\">Os Munic\u00edpios de Loures e Odivelas organizam pela terceira\u00a0vez a Meia Maratona \u2013 Odivelas-Loures-Odivelas, no dia 21\u00a0de setembro. Sob o slogan Juntos pelo Desporto, as duas autarquias unem-se para reviver uma prova de atletismo que se realizava nos anos 80 e 90 e que ligava as duas cidades. Numa data em que se comemora a Semana Europeia do Desporto, a iniciativa, integra tamb\u00e9m, uma corrida de 10km, uma caminhada de 5km e uma corrida kids para os mais pequenos na v\u00e9spera.<\/p>\n\n\n","protected":false},"author":1,"featured_media":41446,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28,41],"event_type_2":[33,727],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-41445","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-odivelas-lisboa","event_organizer-we-run","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type-meiamaratona","event_type_2-lisboa","event_type_2-lisboa-e-centro"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/04\/cartaz_mm_odivelas-loures_2025.600x850.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/41445","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=41445"}],"version-history":[{"count":1,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/41445\/revisions"}],"predecessor-version":[{"id":61015,"href":"https:\/\/www.portugalrunning.