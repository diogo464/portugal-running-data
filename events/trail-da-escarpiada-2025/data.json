{"id":44175,"date":"2025-08-29T07:25:34","date_gmt":"2025-08-29T06:25:34","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=44175"},"modified":"2026-08-23T23:48:43","modified_gmt":"2026-08-23T22:48:43","slug":"trail-da-escarpiada-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-da-escarpiada-2025\/","title":{"rendered":"Trail da Escarpiada 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A ARCD Venda da Lu\u00edsa vai realizar no dia 22 de novembro de 2025 o V Trail da Escarpiada. A prova ter\u00e1 partida e chegada junto \u00e0 Associa\u00e7\u00e3o da aldeia do Casmilo, concelho de Condeixa-a-Nova e percorrer\u00e1 a Serra de Sic\u00f3 nas freguesias do Zambujal e do Furadouro.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ter\u00e1 3 provas competitivas, uma com aproximadamente 31Km (Trail Longo), outra com 16Km (Trail Curto\/Sprint), e ainda uma de 10Km (Mini Trail\/Trail Jovem), para al\u00e9m de uma Caminhada com cerca de 10Km tamb\u00e9m.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>A prova de 31Km integra o Circuito de Trail Longo da Associa\u00e7\u00e3o Distrital de Atletismo de Coimbra.<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":44176,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[37,727],"event_type_3":[],"event_type_4":[],"event_type_5":[823],"class_list":["post-44175","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-zambujal-condeixa-a-nova","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-coimbra","event_type_2-lisboa-e-centro","event_type_5-circuito-atrp"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/08\/IMG-20250827-WA0001_gbWz6yh-1.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/44175","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=44175"}],"version-history":[{"count":1,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/44175\/revisions"}],"predecessor-version":[{"id":62486,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/44175\/revisions\/62486"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/44176"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=44175"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/tags?post=44175"},{"taxonomy":"event_type","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/event_type?post=44175"},{"taxonomy":"event_type_2","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/event_type_2?post=44175"},{"taxonomy":"event_type_3","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/event_type_3?post=44175"},{"taxonomy":"event_type_4","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/event_type_4?post=44175"},{"taxonomy":"event_type_5","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/event_type_5?post=44175"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}