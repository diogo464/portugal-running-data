\": \"A organiza\u00e7\u00e3o disponibiliza 3 postos de abastecimento ao longo do tra\u00e7ado nos lugares de Antela (Real), V\u00e1rzea e Ladroeira, al\u00e9m do refor\u00e7o na meta.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":60532,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,559,478],"event_type_2":[34,727],"event_type_3":[744],"event_type_4":[],"event_type_5":[],"class_list":["post-60531","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-castelo-de-paiva-aveiro","event_type-caminhada","event_type-corrida","event_type-corrida-de-15-km","event_type-corridas-inferior-10","event_type_2-aveiro","event_type_2-lisboa-e-centro","event_type_3-sim"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/08\/vidimas.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/60531","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=60531"}],"version-history":[{"count":3,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/60531\/revisions"}],"predecessor-version":[{"id":65780,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/60531\/revisions\/65780"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/60532"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=60531"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"h