{"id":39680,"date":"2025-01-12T19:24:52","date_gmt":"2025-01-12T18:24:52","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/trail-esposende-2025\/"},"modified":"2026-08-24T10:02:25","modified_gmt":"2026-08-24T09:02:25","slug":"trail-esposende-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-esposende-2025\/","title":{"rendered":"Trail Esposende 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A C\u00e2mara Municipal de Esposende vai realizar, no dia 23 de mar\u00e7o de 2025, o IX Trail de Esposende. O programa integra tr\u00eas provas: Trail: 32 Km, Trail Sprint: 20 Km e Trail Jovem: 14km. Em paralelo, decorrer\u00e1 uma caminhada de 14km. O Castro de S\u00e3o Louren\u00e7o, em Vila Ch\u00e3, ser\u00e1 o palco deste evento. A competi\u00e7\u00e3o realizar-se-\u00e1 ao longo da Arriba F\u00f3ssil de Esposende, percorrendo os trilhos dos povos que aqui viveram h\u00e1 mais de 2.000 anos.<\/p>\n\n\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":39799,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[52,726],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-39680","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-esposende-braga","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-braga","event_type_2-porto-e-norte"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/01\/TRAIL25_edicao-galaica.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/39680","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portuga