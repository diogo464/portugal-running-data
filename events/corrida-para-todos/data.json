0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Geral Solid\u00e1ria:<\/strong> 5.00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e9 22\/09)<\/span><\/div>\n<\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Caminhada<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Caminhada Inclusiva 2 km<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 27 Set \u2022 \u23f0 Partida: 09:20<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Geral Solid\u00e1ria:<\/strong> 5.00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e9 22\/09 (gratuito at\u00e9 12 anos))<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/ul>\n<\/div>\n<p><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><\/p>\n<div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\">\n<h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quando e onde se realiza a Corrida para Todos 2026?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O evento realiza-se no domingo, <strong>27 de Setembro de 2026<\/strong>, com ponto de encontro, partida e chegada no <strong>Centro de Medicina de Reabilita\u00e7\u00e3o do Sul (CMR Sul)<\/strong>, em S\u00e3o Br\u00e1s de Alportel.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quais s\u00e3o as dist\u00e2ncias e hor\u00e1rios de partida?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O programa inclui a <strong>Corrida de 10 km<\/strong> com partida \u00e0s 09:15, a <strong>Corrida de 5 km<\/strong> \u00e0s 09:20 e a <strong>Caminhada Inclusiva de 2 km<\/strong> \u00e0s 09:20.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Como funciona a entrega dos kits de participa\u00e7\u00e3o?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Os kits podem ser levantados na sexta-feira, 25 de setembro, das 09h00 \u00e0s 16h00 na portaria do CMR Sul, ou no pr\u00f3prio domingo da prova, entre as 08h30 e as 09h00.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">A quem se destina o valor angariado nas inscri\u00e7\u00f5es?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A totalidade da receita l\u00edquida reverte a 100% para o Grupo de Desporto Adaptado do CMR Sul, atrav\u00e9s da Associa\u00e7\u00e3o Elo de Mudan\u00e7a, para a aquisi\u00e7\u00e3o de material desportivo adaptado.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Qual \u00e9 o valor da inscri\u00e7\u00e3o e quem tem isen\u00e7\u00e3o?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A inscri\u00e7\u00e3o tem o valor solid\u00e1rio de 5,00 \u20ac, sendo <strong>gratuita para crian\u00e7as at\u00e9 aos 12 anos<\/strong> e para todos os doentes internados no CMR Sul.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"Corrida para Todos 2026\", \"startDate\": \"2026-09-27\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"S\u00e3o Br\u00e1s de Alportel, Faro\", \"address\": {\"@type\": \"PostalAddress\", \"ad