\"Question\", \"name\": \"Que servi\u00e7os e apoios est\u00e3o inclu\u00eddos na participa\u00e7\u00e3o?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A inscri\u00e7\u00e3o inclui t-shirt oficial do evento, dorsal personalizado, seguro desportivo de acidentes pessoais, abastecimentos s\u00f3lidos e l\u00edquidos, medalha de finalista e acesso a balne\u00e1rios com duche.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":66808,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497],"event_type_2":[24,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-54333","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-rans-penafiel","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type_2-porto","event_type_2-porto-e-norte","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/trail-vale-de-rans-2026.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/54333","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=54333"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/54333\/revisions"}],"predecessor-version":[{"id":68812,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/54333\/revisions\/68812"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/med