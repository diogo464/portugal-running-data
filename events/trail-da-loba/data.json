{"id":47237,"date":"2025-12-13T08:55:27","date_gmt":"2025-12-13T07:55:27","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=47237"},"modified":"2026-08-23T22:59:32","modified_gmt":"2026-08-23T21:59:32","slug":"trail-da-loba","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-da-loba\/","title":{"rendered":"Trail da Loba 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O 8\u00ba Trail da Loba ser\u00e1 realizado no dia 25\/01\/2026 em Rio de Loba \u2013 Viseu. <\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Este evento \u00e9 organizado pela Junta de Freguesia de Rio de Loba, em parceria com o Centro Social Cultural Recreativo e Desportivo Le\u00f5es da Beira e tem como objetivo promover a pr\u00e1ticada atividade f\u00edsica, dando a conhecer os trilhos e caminhos da Freguesia de Rio de Loba.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><br>O Trail \u00e9 composto por tr\u00eas percursos:<\/p>\n\n\n\n<ul class=\"wp-block-list\" >\n<li>Trail Longo de +\/- 30Km<\/li>\n\n\n\n<li>Trail Curto de +\/- 15Km <\/li>\n\n\n\n<li>Mini-Trail de +\/- 10Km <\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">A Caminhada de +\/- 8Km.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":47238,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[726,820,102],"event_type_3":[],"event_type_4":[],"event_type_5":[823],"class_list":["post-47237","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-rio-de-loba-viseu","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-porto-e-norte","event_type_2-portugal","event_type_2-viseu","event_type_5-circuito-atrp"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/1