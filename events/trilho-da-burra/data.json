{"id":48883,"date":"2026-02-10T07:05:26","date_gmt":"2026-02-10T06:05:26","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=48883"},"modified":"2026-08-23T22:49:42","modified_gmt":"2026-08-23T21:49:42","slug":"trilho-da-burra","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trilho-da-burra\/","title":{"rendered":"Trilho da Burra\u00a02026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A C\u00e2mara Municipal de Castro Daire e a ADCR de Vila Boa organizam, no dia 7 de mar\u00e7o de 2026, na localidade de Vila Boa, em colabora\u00e7\u00e3o com a Junta de Freguesia de M\u00f5es e Associa\u00e7\u00e3o de Atletismo de Viseu, o 5\u00ba TRILHO DA BURRA, corrida pedestre em natureza aberta a atletas de ambos os sexos, sem limite<br>de idade.<br>Este evento \u00e9 aberto a atletas e caminheiros de ambos os sexos, federados ou populares, em representa\u00e7\u00e3o de clubes, escolas, coletividades, grupos informais ou a t\u00edtulo individual e est\u00e1 integrado no \u201c(PER) CORRER CASTRO DAIRE\u201d 2026 \u2013 2\u00aa jornada, e consta de uma CORRIDA PEDESTRE, na dist\u00e2ncia de 10 km (tempo limite de 2H00), uma CAMINHADA, na dist\u00e2ncia de 6,5 km (tempo limite de 1h30 horas), e CORRIDAS JOVENS para atletas dos escal\u00f5es de forma\u00e7\u00e3o (Benjamins a Juvenis).<\/p>\n\n\n","protected":false},"author":1,"featured_media":46090,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497],"event_type_2":[726,820,102],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-48883","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-vila-boa-castro-daire","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type_2-porto-e-norte","event_type_2-portugal","event_type_2-viseu"],"acf":[],"featured_image_src":"https:\/\