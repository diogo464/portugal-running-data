-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Entidade Organizadora<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">Duelo D\u2019Ocasi\u00e3o - Associa\u00e7\u00e3o<\/span><\/li><li class=\"pr-tech-snapshot-item\" style=\"display: flex; flex-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Tempo Limite (Cut-off)<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">5h30 (barreira hor\u00e1ria \u00e0s 4h00 no \u00faltimo abastecimento)<\/span><\/li><li class=\"pr-tech-snapshot-item\" style=\"display: flex; flex-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Tipo de Piso<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">Trilhos de montanha, caminhos florestais e margens do rio Paiva<\/span><\/li><li class=\"pr-tech-snapshot-item\" style=\"display: flex; flex-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Perfil & Relevo<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">Montanhoso (1800 m D+ no Trail 35K, 1100 m D+ no Trail 23K e 700 m D+ no Trail 15K)<\/span><\/li><li class=\"pr-tech-snapshot-item\" style=\"display: flex; flex-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #C4B5FD; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Regulamento Oficial<\/strong><span class=\"pr-tech-snapshot-val\" style=\"font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\"><a href=\"https:\/\/stopandgo.net\/storage\/events\/viii-trail-do-rio-paiva\/regulamento_pt_1793124009.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: #38BDF8; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;\">\n                    \ud83d\udcc4 Abrir Regulamento Oficial (PDF) &rarr;\n                <\/a><\/span><\/li><div style=\"grid-column: 1 \/ -1; margin-top: 8px;\"><strong style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 10px;\">\ud83c\udfc3 Programa de Provas & Sub-eventos<\/strong><div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;