0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Fitness Racing<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">PERFORMANCE Singles Feminino<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\u23f0 Partida: 10:30<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">55,00 \u20ac<\/span><\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Fitness Racing<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">PERFORMANCE Duplas Masculinas \/ Femininas \/ Mistas<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\u23f0 Partida: 12:00<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">90,00 \u20ac<\/span><\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Fitness Racing<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">PERFORMANCE Estafetas Masculinas \/ Femininas \/ Mistas<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\u23f0 Partida: 15:00<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">140,00 \u20ac<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/ul>\n<\/div>\n<p><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><\/p>\n<div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\">\n<h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Como funciona o formato de competi\u00e7\u00e3o do RFM Performance MANZ Games?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O formato consiste em 7 voltas de corrida de 600 metros (total de 4.200m). Entre cada volta de 600m, o atleta completa obrigatoriamente uma das 7 esta\u00e7\u00f5es de treino funcional (Remo, Slam Ball, Farmer Carry, SkiErg, Lunges, Burpees e Wall Ball).<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde se realiza o evento e como chegar?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A prova decorre no Complexo Desportivo Municipal 1\u00ba de Maio (INATEL), situado na Avenida Rio de Janeiro, no cora\u00e7\u00e3o de Lisboa, com excelentes acessos via Metro (Esta\u00e7\u00f5es de Alvalade e Roma) e rede Carris.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">\u00c9 poss\u00edvel participar em equipa ou duplas?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Sim. Al\u00e9m das divis\u00f5es individuais (Singles Masculino e Feminino), existem categorias de Duplas (masculinas, femininas e mistas) e Estafetas de 4 elementos, tornando o desafio acess\u00edvel a v\u00e1rios n\u00edveis de prepara\u00e7\u00e3o f\u00edsica.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Como s\u00e3o cronometrados os tempos?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Cada participante recebe um chip eletr\u00f3nico oficial da Lap2Go que regista os tempos da corrida e das transi\u00e7\u00f5es entre esta\u00e7\u00f5es, com resultados em direto e ranking global por escal\u00e3o.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"RFM Performance MANZ Games 2026\", \"startDate\": \"2026-09-05\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Complexo Desportivo Municipal 1\u00ba de Maio (INATEL)\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Lisboa\", \"addressRegion\": \"Lisboa\", \"addressCountry\": \"PT\"}}, \"organizer\": {\"@type\": \"Organization\", \"name\": \"MANZ Produ\u00e7\u00f5es & RFM\"}}<\/script><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Como funciona o formato de competi\u00e7\u00e3o do RFM Performance MANZ Games?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O formato consiste em 7 voltas de corrida de 600 metros (total de 4.200m). Entre cada volta de 600m, o atleta completa obrigatoriamente uma das 7 esta\u00e7\u00f5es de treino funcional (Remo, Slam Ball, Farmer Carry, SkiErg, Lunges, Burpees e Wall Ball).\"}}, {\"@type\": \"Question\", \"name\": \"Onde se realiza o evento e como chegar?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A prova decorre no Complexo Desportivo Municipal 1\u00ba de Maio (INATEL), situado na Avenida Rio de Janeiro, no cora\u00e7\u00e3o de Lisboa, com excelentes acessos via Metro (Esta\u00e7\u00f5es de Alvalade e Roma) e rede Carris.\"}}, {\"@type\": \"Question\", \"name\": \"\u00c9 poss\u00edvel participar em equipa ou duplas?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sim. Al\u00e9m das divis\u00f5es individuais (Singles Masculino e Feminino), existem categorias de Duplas (masculinas, femininas e mistas) e Estafetas de 4 elementos, tornando o desafio acess\u00edvel a v\u00e1rios n\u00edveis de prepara\u00e7\u00e3o f\u00edsica.\"}}, {\"@type\": \"Question\", \"name\": \"Como s\u00e3o cronometrados os tempos?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Cada participante recebe um chip eletr\u00f3nico oficial da Lap2Go que regista os tempos da corrida e das transi\u00e7\u00f5es entre esta\u00e7\u00f5es, com resultados em direto e ranking global por escal\u00e3o.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":66763,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,1455],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-66668","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-lisboa","event_type-corrida","event_type-hyrox","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/rfm-performance-manz-games-2026-1.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/66668","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=66668"}],"version-history":[{"count":2,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/66668\/revisions"}],"predecessor-version":[{"id":67185,"href":"https:\/\/www.portu