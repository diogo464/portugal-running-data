{"id":41729,"date":"2025-05-01T08:28:11","date_gmt":"2025-05-01T07:28:11","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=41729"},"modified":"2026-08-24T08:49:18","modified_gmt":"2026-08-24T07:49:18","slug":"oudinot-race-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/oudinot-race-2025\/","title":{"rendered":"Oudinot Race 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">3\u00ba Oudinot Race OCR \u00e9 uma prova diferente rodeada por uma fant\u00e1stica paisagem, realizado no jardim Oudinot na Gafanha da Nazar\u00e9.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Prova organizada pela associa\u00e7\u00e3o B\u00fassola Partilhada, ser\u00e1 uma corrida de obst\u00e1culos no interior jardim Oudinot com cerca 30 Obst\u00e1culos perfazendo 12 km Elite e 6Km Overall.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A prova ir\u00e1 realizar-se no dia 22 Junho de 2025, com a partida e chega no Jardim Oudinot, contando com os mais diversos obst\u00e1culos.<\/p>\n\n\n","protected":false},"author":1,"featured_media":41730,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,519],"event_type_2":[34,726],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-41729","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-gafanha-da-nazare-ilhavo","event_type-corrida","event_type-obstaculos","event_type_2-aveiro","event_type_2-porto-e-norte"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/05\/oudinot25_banner-1024x360.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/41729","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\