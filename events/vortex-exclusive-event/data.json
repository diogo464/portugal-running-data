pon\u00edvel nesta p\u00e1gina.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":70519,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,1455],"event_type_2":[728,149,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-70517","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-albufeira-faro","event_type-corrida","event_type-hyrox","event_type_2-algarve-e-sul","event_type_2-faro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/10\/cartaz-vortex-exclusive-event.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/70517","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=70517"}],"version-history":[{"count":2,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/70517\/revisions"}],"predecessor-version":[{"id":70520,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/70517\/revisions\/70520"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/70519"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=70517"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/tags?post=70517"},{"taxonomy":"event_type","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/event_type?post=70517"},{"taxonom