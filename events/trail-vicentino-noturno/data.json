as para inscri\u00e7\u00e3o?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As inscri\u00e7\u00f5es encerram a 4 de outubro de 2026 na plataforma Acorrer.pt (ou ao atingir o limite de 400 participantes), variando os valores entre 11,00 \u20ac e 23,00 \u20ac.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":66248,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[104,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-51863","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-ponta-delgada-acores","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-acores","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/trail-vicentino-noturno-2026.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51863","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=51863"}],"version-history":[{"count":3,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51863\/revisions"}],"predecessor-version":[{"id":65846,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51863\/revisions\/65846"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/66248"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=51863