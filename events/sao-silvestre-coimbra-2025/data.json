o.com\/pt\/event\/sscoimbra-2025\/timetable\" target=\"_blank\" rel=\"noopener\">Resultados 2025<\/a><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">A festa da S\u00e3o Silvestre aproxima-se. Cada vez mais ativa e relevante, a S\u00e3o Silvestre de Coimbra continua a garantir a tradi\u00e7\u00e3o e a m\u00edstica de ser uma das mais antigas provas de S\u00e3o Silvestre em Portugal. Vem participar e fazer a festa, antes de entrares na prepara\u00e7\u00e3o do Natal.<\/p>\n","protected":false},"author":1,"featured_media":42845,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[28,672,27,47],"event_type_2":[37,727],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-42844","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-coimbra","event_type-corrida-10-km","event_type-caminhada","event_type-corrida","event_type-sao-silvestre","event_type_2-coimbra","event_type_2-lisboa-e-centro"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/06\/banner-sscoimbra-2025-min.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/42844","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=42844"}],"version-history":[{"count":4,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/42844\/revisions"}],"predecessor-version":[{"id":60958,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/42844\/revisions\/60958"}],"wp:featuredmedia":[{"embeddable":tru