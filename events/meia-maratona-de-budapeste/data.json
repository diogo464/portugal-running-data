{"id":47207,"date":"2025-12-11T07:45:15","date_gmt":"2025-12-11T06:45:15","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=47207"},"modified":"2026-08-02T20:20:26","modified_gmt":"2026-08-02T19:20:26","slug":"meia-maratona-de-budapeste","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-de-budapeste\/","title":{"rendered":"Meia Maratona de Budapeste 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A Wizz Air Meia Maratona de Budapeste n\u00e3o \u00e9 apenas uma corrida de 21,097 km; \u00e9 uma experi\u00eancia de <em>sightseeing<\/em> que transforma a capital h\u00fangara numa pista de atletismo vibrante, oferecendo um dos percursos mais belos e r\u00e1pidos da Europa Central.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">O percurso \u00e9 notoriamente <strong>plano e r\u00e1pido<\/strong>, ideal para quem procura bater o seu recorde pessoal (PB), e \u00e9 integralmente asfaltado. Os corredores desfrutam de vistas ininterruptas de ambos os lados da cidade (Buda, montanhosa, e Peste, plana), ligadas pelo majestoso <strong>Rio Dan\u00fabio<\/strong>.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":47209,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":[],"tags":[],"event_type":[27,28,41],"event_type_2":[627,1416],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-47207","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-budapeste-hungria","event_type-corrida","event_type-corrida-10-km","event_type-meiamaratona","event_type_2-europa","event_type_2-hungria"],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/12\/565695577_1266305545542031_3407271038771417793_n-1-1024x379.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalr