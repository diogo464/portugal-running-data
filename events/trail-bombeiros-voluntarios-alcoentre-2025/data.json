{"id":45901,"date":"2025-10-19T07:28:05","date_gmt":"2025-10-19T06:28:05","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=45901"},"modified":"2026-08-23T23:27:05","modified_gmt":"2026-08-23T22:27:05","slug":"trail-bombeiros-voluntarios-alcoentre-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-bombeiros-voluntarios-alcoentre-2025\/","title":{"rendered":"Trail Bombeiros Volunt\u00e1rios Alcoentre 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O Trail dos Bombeiros Volunt\u00e1rios de Alcoentre (TRAIL BV Alcoentre) ser\u00e1 realizado no dia 7 de dezembro de 2025, em Alcoentre e ser\u00e1 constitu\u00eddo por uma Prova com cerca de 23 Km, um Mini-Trail de 13 km aproximadamente e uma Caminhada com cerca de 10Km e ser\u00e1 a \u00faltima prova do Circuito do Torricado.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><br>\u00c9 uma organiza\u00e7\u00e3o da Associa\u00e7\u00e3o Humanit\u00e1ria de Bombeiros de Alcoentre, em parceria com a C\u00e2mara Municipal de Azambuja e a Junta de Freguesia de Alcoentre.<\/p>\n\n\n","protected":false},"author":1,"featured_media":45902,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497],"event_type_2":[33,727],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-45901","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-alcoentre-azambuja","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type_2-lisboa","event_type_2-lisboa-e-centro"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/10\/pop_ek5h2dk916.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/45901","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json