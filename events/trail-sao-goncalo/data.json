tecimentos, refor\u00e7o no final e seguro desportivo. No Trail de 15 km \u00e9 obrigat\u00f3rio o uso de manta t\u00e9rmica, telem\u00f3vel operacional e apito (na caminhada \u00e9 obrigat\u00f3rio telem\u00f3vel operacional).\"}}, {\"@type\": \"Question\", \"name\": \"Onde posso consultar o regulamento oficial do Trail Solid\u00e1rio S\u00e3o Gon\u00e7alo 2026?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O regulamento oficial completo em formato PDF pode ser descarregado diretamente atrav\u00e9s do bot\u00e3o de regulamento dispon\u00edvel nesta p\u00e1gina.\"}}]}<\/script>","protected":false},"author":1,"featured_media":72976,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[22,672,497],"event_type_2":[24,726,820],"event_type_3":[],"event_type_4":[811],"event_type_5":[],"class_list":["post-72975","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-santo-tirso-porto","event_type-trail","event_type-caminhada","event_type-trail-curto","event_type_2-porto","event_type_2-porto-e-norte","event_type_2-portugal","event_type_4-solidaria-sim"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/11\/cartaz-trail-sao-goncalo.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/72975","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=72975"}],"version-history":[{"count":2,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/72975\/revisions"}],"predecessor-