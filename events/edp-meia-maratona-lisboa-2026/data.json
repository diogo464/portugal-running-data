{"id":43521,"date":"2025-09-23T15:20:05","date_gmt":"2025-09-23T14:20:05","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/edp-meia-maratona-lisboa-2026\/"},"modified":"2026-08-21T00:01:05","modified_gmt":"2026-08-20T23:01:05","slug":"edp-meia-maratona-lisboa-2026","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/edp-meia-maratona-lisboa-2026\/","title":{"rendered":"EDP Meia Maratona de Lisboa 2026"},"content":{"rendered":"<div class=\"pr-expired-notice\" style=\"background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(30, 41, 59, 0.6) 100%); border: 1px solid rgba(139, 92, 246, 0.35); border-radius: 16px; padding: 18px 24px; margin-bottom: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;\"><div style=\"display: flex; align-items: center; gap: 12px; flex: 1; min-width: 260px;\"><span style=\"font-size: 24px;\">\ud83c\udfc3\u200d\u2642\ufe0f<\/span><div><strong style=\"color: #FFFFFF; font-size: 15px; font-family: 'Outfit', sans-serif;\">Esta edi\u00e7\u00e3o j\u00e1 decorreu.<\/strong><p style=\"font-size: 13.5px; color: #CBD5E1; margin: 2px 0 0 0;\">Consulta os resultados desta prova abaixo ou acede a todos os detalhes da edi\u00e7\u00e3o atual.<\/p><\/div><\/div><a href=\"https:\/\/www.portugalrunning.com\/eventos\/edp-meia-maratona-lisboa\/\" style=\"background: #8B5CF6 !important; color: #FFFFFF !important; font-weight: 700 !important; font-size: 13.5px !important; text-decoration: none !important; padding: 11px 22px !important; border-radius: 10px !important; white-space: nowrap !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; height: 42px !important; margin: 0 !important; border: none !important; line-height: 1 !important; box-shadow: 0 4px 14px rgba(139, 92, 246, 0.4) !important;\">Ver Edi\u00e7\u00e3o Atual &rarr;<\/a><\/div>\n\n\n<p class=\"wp-block-paragraph\">Considerada uma das meias maratonas mais r\u00e1pidas do mundo, foi palco de recordes mundiais masculinos da dist\u00e2ncia (2000, 2010 e 2021) e oferece condi\u00e7\u00f5es ideais para recordes pessoais com o seu tra\u00e7ado maioritariamente plano ao longo das margens do Tejo. A prova integra o circuito SuperHalfs desde a sua cria\u00e7\u00e3o, permitindo aos corredores iniciarem ou completarem o desafio de conquistar a Super Medalha.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":43526,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,28,41],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[882],"class_list":["post-43521","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-lisboa","event_type-corrida","event_type-corrida-10-km","event_type-meiamaratona","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal","event_type_5-superhalfs"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/07\/EDP-Meia-Maratona-Lisboa-2026-1-1024x449.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/43521","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=43521"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/43521\/revisions"}],"predecessor-version":[{"id":60952,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/43521\/revisio