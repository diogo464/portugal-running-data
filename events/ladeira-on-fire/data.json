 um pr\u00e9mio exclusivo para o melhor tempo da prova.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":69603,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,478,681],"event_type_2":[38,727,820],"event_type_3":[],"event_type_4":[811],"event_type_5":[],"class_list":["post-55231","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-nazare-leiria","event_type-corrida","event_type-corridas-inferior-10","event_type-outras","event_type_2-leiria","event_type_2-lisboa-e-centro","event_type_2-portugal","event_type_4-solidaria-sim"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/10\/cartaz-ladeira-on-fire-2.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55231","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=55231"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55231\/revisions"}],"predecessor-version":[{"id":69604,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55231\/revisions\/69604"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/69603"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=55231"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/tags?post=55231"},{"taxonomy":"event_type","embeddable":true,"h