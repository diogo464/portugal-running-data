{"id":42508,"date":"2025-06-12T10:51:39","date_gmt":"2025-06-12T09:51:39","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=42508"},"modified":"2026-08-24T06:59:31","modified_gmt":"2026-08-24T05:59:31","slug":"trail-feira-das-cebolas-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-feira-das-cebolas-2025\/","title":{"rendered":"Trail Feira das Cebolas 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O trail Feira das Cebolas \u00e9 uma prova desportiva integrada na Feira das Cebolas e Mostra comunit\u00e1ria de Gondifelos que pretende promover a pr\u00e1tica desportiva junto da comunidade.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">O Trail Feira das Cebolas conta com duas dist\u00e2ncias competitivas:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2022mini trail com a dist\u00e2ncia de 12 km;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2022trail com a dist\u00e2ncia de 18 km;<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">H\u00e1 tamb\u00e9m uma caminhada de 8 km sem fins competitivos,<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Todas as provas percorrem trilhos e caminhos de Gondifelos e Caval\u00f5es com o rio este como atrac\u00e7\u00e3o principal.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":42509,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497],"event_type_2":[52,726],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-42508","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-gondidelos-vila-nova-de-famalicao","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type_2-braga","event_type_2-porto-e-norte"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/06\/d7b8.jpg","ams_acf":[],"_li