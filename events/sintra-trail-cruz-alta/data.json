0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Tipo de Piso<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">Estradas de terra batida e trilhos florestais da Serra de Sintra com alguns atravessamentos urbanos<\/span><\/li><li class=\"pr-tech-snapshot-item\" style=\"display: flex; flex-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Perfil & Relevo<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">Montanhoso de dificuldade t\u00e9cnica moderada (750m D+ nos 20 km, 550m D+ nos 12 km e 450m D+ nos 8 km)<\/span><\/li><li class=\"pr-tech-snapshot-item\" style=\"display: flex; flex-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #C4B5FD; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Regulamento Oficial<\/strong><span class=\"pr-tech-snapshot-val\" style=\"font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\"><a href=\"https:\/\/sintratrail.pt\/site\/assets\/guia_cruzalta_26.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: #38BDF8