nd: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #C4B5FD; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Regulamento Oficial<\/strong><span class=\"pr-tech-snapshot-val\" style=\"font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\"><a href=\"https:\/\/www.macaomarathon.com\/uploads\/2025\/course_map\/macau_marathon_full_track_v2.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: #38BDF8; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;\"><br \/>\n                    \ud83d\udcc4 Abrir Regulamento Oficial (PDF) &rarr;<br \/>\n                <\/a><\/span><\/li>\n<div style=\"grid-column: 1 \/ -1; margin-top: 8px;\"><strong style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 10px;\">\ud83c\udfc3 Programa de Provas &#038; Sub-eventos<\/strong><\/p>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;\">\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Maratona<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Maratona 42,195 km (Certificada AIMS \/ World Athletics)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\u23f0 Partida: 06:00<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Atletas N\u00e3o Locais (400 MOP):<\/strong> 46,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Lota\u00e7\u00e3o Esgotada (2.000 vagas))<\/span><\/div>\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Residentes RAEM (150 MOP):<\/strong> 17,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Lota\u00e7\u00e3o Esgotada)<\/span><\/div>\n<\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Meia Maratona<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Meia Maratona 21,0975 km<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\u23f0 Partida: 06:00<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Atletas N\u00e3o Locais (400 MOP):<\/strong> 46,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Lota\u00e7\u00e3o Esgotada (5.000 vagas))<\/span><\/div>\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Residentes RAEM (150 MOP):<\/strong> 17,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Lota\u00e7\u00e3o Esgotada)<\/span><\/div>\n<\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Corrida de Estrada<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Mini Maratona (~5 km)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\u23f0 Partida: 06:20<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Atletas N\u00e3o Locais (70 MOP):<\/strong> 8,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Lota\u00e7\u00e3o Esgotada (5.000 vagas))<\/span><\/div>\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Residentes RAEM (50 MOP):<\/strong> 6,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Lota\u00e7\u00e3o Esgotada)<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/ul>\n<\/div>\n<p><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><\/p>\n<div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\">\n<h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quando e a que horas se realiza a Maratona Internacional de Macau 2026?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A 45\u00aa edi\u00e7\u00e3o realiza-se no domingo, 6 de dezembro de 2026, com partida e chegada no Est\u00e1dio do Centro Desportivo Ol\u00edmpico, na Taipa (Macau). A abertura das portas ocorre \u00e0s 05:00, a Maratona (42,195 km) e a Meia Maratona (21,0975 km) partem \u00e0s 06:00, e a Mini Maratona (~5 km) parte \u00e0s 06:20.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quais s\u00e3o os tempos limite (cut-off) de cada dist\u00e2ncia?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A Maratona tem um tempo limite de 6 horas (encerramento \u00e0s 12:00), a Meia Maratona disp\u00f5e de 3 horas (encerramento \u00e0s 09:00) e a Mini Maratona tem um limite de 1 hora e 15 minutos (encerramento \u00e0s 07:35).<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quais s\u00e3o os pre\u00e7os e vagas de inscri\u00e7\u00e3o para atletas internacionais?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">As quotas oficiais s\u00e3o de 2.000 vagas na Maratona, 5.000 na Meia Maratona e 5.000 na Mini Maratona (total de 12.000 vagas, j\u00e1 esgotadas ap\u00f3s a abertura em outubro). As taxas para atletas n\u00e3o locais s\u00e3o de 400 MOP (aprox. 46,00 \u20ac) na Maratona e Meia Maratona, e 70 MOP (aprox. 8,00 \u20ac) na Mini Maratona.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde e quando \u00e9 feito o levantamento do dorsal e kit de participante?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O levantamento do dorsal numerado com chip realiza-se no Broadway Macau (piso M\/F) entre os dias 2 e 4 de dezembro de 2026, das 12:00 \u00e0s 21:00, e na v\u00e9spera da prova (s\u00e1bado, 5 de dezembro), das 10:00 \u00e0s 22:00, mediante apresenta\u00e7\u00e3o do recibo de aprova\u00e7\u00e3o e documento de identifica\u00e7\u00e3o.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Como funcionam os abastecimentos ao longo do percurso?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Existe um posto de \u00e1gua aos primeiros 5 km e, a partir da\u00ed, esta\u00e7\u00f5es de abastecimento com \u00e1gua, bebidas isot\u00f3nicas e esponjas a cada 2,5 km, al\u00e9m de dois postos de chuveiros (na Pen\u00ednsula de Macau e no Cotai). \u00c0 chegada s\u00e3o fornecidos \u00e1gua, isot\u00f3nico, bananas e chocolate, juntamente com a medalha oficial.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"Maratona Internacional de Macau 2026\", \"startDate\": \"2026-12-06\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Centro Desportivo Ol\u00edmpico - Est\u00e1dio (Taipa)\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Macau\", \"addressRegion\": \"Macau (RAEM)\", \"addressCountry\": \"MO\"}}, \"organizer\": {\"@type\": \"Organization\", \"name\": \"Instituto do Desporto do Governo da RAEM, Galaxy Entertainment Group e Associa\u00e7\u00e3o Geral de Atletismo de Macau\"}}<\/script><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": []}<\/script><\/p>\n","protected":false},"author":1,"featured_media":70186,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,478,31,41],"event_type_2":[1451,1424],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-47585","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-macau","event_type-corrida","event_type-corridas-inferior-10","event_type-maratona","event_type-meiamaratona","event_type_2-asia","event_type_2-macau"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/10\/cartaz-maratona-de-macau.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/47585","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/c