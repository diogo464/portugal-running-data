{"id":47134,"date":"2025-12-08T06:46:15","date_gmt":"2025-12-08T05:46:15","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=47134"},"modified":"2026-08-23T23:14:02","modified_gmt":"2026-08-23T22:14:02","slug":"corrida-de-reis-figueiro-dos-vinhos-2026","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-de-reis-figueiro-dos-vinhos-2026\/","title":{"rendered":"Corrida de Reis Figueir\u00f3 dos Vinhos 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A Corrida de Reis Figueir\u00f3 dos Vinhos 2026 \u00e9 uma prova organizada pelo Clube de Praticantes Mondego Ultra Trail, NIF 902118820, com sede na Rua da Igreja n\u00ba 2, Torres do Mondego, 3030-348 Coimbra, tendo como co-organizador o munic\u00edpio de Figueir\u00f3 dos Vinhos.<br><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A Corrida de Reis Figueir\u00f3 dos Vinhos 2026 realiza-se no dia 3 de janeiro de 2026, com a prova a ter in\u00edcio \u00e0s 18:30. Para al\u00e9m da dist\u00e2ncia de 8 km de corrida, contar\u00e1 com caminhada de 4 km e uma prova n\u00e3o competitiva destinada a crian\u00e7as.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":47135,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,478],"event_type_2":[38,727],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-47134","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-figueiro-dos-vinhos-leiria","event_type-caminhada","event_type-corridas-inferior-10","event_type_2-leiria","event_type_2-lisboa-e-centro"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/12\/2025-12-07_08-22-35_6935394b2fdc0-1-1024x380.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portu