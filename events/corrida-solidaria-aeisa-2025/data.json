{"id":41026,"date":"2025-03-14T23:08:59","date_gmt":"2025-03-14T22:08:59","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=41026"},"modified":"2026-08-24T09:28:56","modified_gmt":"2026-08-24T08:28:56","slug":"corrida-solidaria-aeisa-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-solidaria-aeisa-2025\/","title":{"rendered":"Corrida Solid\u00e1ria AEISA 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A&nbsp;<strong>Associa\u00e7\u00e3o dos Estudantes do Instituto Superior de Agronomia<\/strong>&nbsp;apresenta a \u201cIV Corrida Solid\u00e1ria AEISA\u201d, a realizar-se no&nbsp;<strong>dia&nbsp;26 de abril de 2025<\/strong>, com o apoio do ISA, CM-Lisboa, Junta de Freguesia da Ajuda, Junta de Freguesia de Alc\u00e2ntara, ADESL, FAL, ULisboa, Mais Superior e Xistarca.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A&nbsp;<strong>Associa\u00e7\u00e3o dos Estudantes do Instituto Superior de Agronomia&nbsp;<\/strong>pretende&nbsp;oferecer aos participantes um&nbsp;<strong>percurso desafiante pelos brilhantes cen\u00e1rios<\/strong>&nbsp;que ir\u00e3o encontrar na Tapada da Ajuda e Mata de Monsanto, bem como a oportunidade de contribuir para uma&nbsp;<strong>causa solid\u00e1ria<\/strong>.<\/p>\n","protected":false},"author":1,"featured_media":41027,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28,478],"event_type_2":[33,727],"event_type_3":[],"event_type_4":[811],"event_type_5":[],"class_list":["post-41026","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-monsanto-lisboa","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type-corridas-inferior-10","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_4-solidarias-sim"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-conten