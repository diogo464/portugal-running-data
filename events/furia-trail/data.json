52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">18.00\u20ac<\/span><\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Trail Running<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Mini Trail<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 8 Nov \u2022 \u23f0 Partida: 08:45<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">15.00\u20ac<\/span><\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Trail Running<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Experi\u00eancia Trail<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 8 Nov \u2022 \u23f0 Partida: 09:00<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">13.00\u20ac<\/span><\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Caminhada<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Caminhada<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 8 Nov \u2022 \u23f0 Partida: 09:10<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">12.00\u20ac<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/ul>\n<\/div>\n<p><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><\/p>\n<div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\">\n<h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Qual \u00e9 a data e o hor\u00e1rio do F\u00faria Trail 2026?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O evento principal decorre no dia 8 de Novembro de 2026 (Domingo), com as partidas do Trail Curto \u00e0s 08:30, Mini Trail \u00e0s 08:45, Experi\u00eancia Trail \u00e0s 09:00 e Caminhada \u00e0s 09:10. As provas Trail Kids realizam-se na v\u00e9spera (S\u00e1bado) a partir das 17:00.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde \u00e9 o local de partida da corrida?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A zona de concentra\u00e7\u00e3o, partida e chegada estar\u00e1 localizada na freguesia de Freixianda, no concelho de Our\u00e9m (distrito de Santar\u00e9m).<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quais s\u00e3o as dist\u00e2ncias oficiais dispon\u00edveis?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O cartaz de 2026 oferece as dist\u00e2ncias de 21 km (Trail Curto), 14 km (Mini Trail), 10 km (Experi\u00eancia Trail e Caminhada), e ainda escal\u00f5es formativos de Trail Kids (1 a 2 km).<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quem \u00e9 a entidade organizadora?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O evento \u00e9 uma organiza\u00e7\u00e3o da Associa\u00e7\u00e3o Cultural e Recreativa Vale do Nab\u00e3o (ACRVN), apoiada pelo Munic\u00edpio de Our\u00e9m e Juntas de Freguesia locais.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde posso consultar os resultados e as fotografias da prova?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Ap\u00f3s a conclus\u00e3o do evento, os resultados oficiais e os tempos dos atletas poder\u00e3o ser consultados no portal Portugal Running. As fotografias oficiais ser\u00e3o posteriormente partilhadas pela organiza\u00e7\u00e3o.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"3\u00ba F\u00faria Trail 2026\", \"startDate\": \"2026-11-08\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Freixianda, Our\u00e9m\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Our\u00e9m\", \"addressRegion\": \"Santar\u00e9m\", \"addressCountry\": \"PT\"}}, \"organizer\": {\"@type\": \"Organization\", \"name\": \"ACRVN \/ Munic\u00edpio de Our\u00e9m\"}}<\/script><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Qual \u00e9 a data e o hor\u00e1rio do F\u00faria Trail 2026?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O evento principal decorre no di