{"id":45978,"date":"2025-10-25T08:50:27","date_gmt":"2025-10-25T07:50:27","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=45978"},"modified":"2026-08-23T23:26:37","modified_gmt":"2026-08-23T22:26:37","slug":"cross-dos-cavaleiros-de-vale-santiago-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/cross-dos-cavaleiros-de-vale-santiago-2025\/","title":{"rendered":"Cross dos Cavaleiros de Vale Santiago 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">\u039f e N\u00facleo Desportivo e Cultural de Odemira, em parceria com o Munic\u00edpio de Odemira Freguesia de Vale de Santiago, o apoio das empresas Vitacress, Intermarche de Odemira, Caixa de Credito Agr\u00edcola de S\u00e3o Teot\u00f3nio, com o apoio t\u00e9cnico da Associa\u00e7\u00e3o de Atletismo de Beja e da Associa\u00e7\u00e3o Humanit\u00e1ria dos Bombeiros Volunt\u00e1rios de Odemira, ir\u00e1 levar a efeito, no dia 7 de Dezembro, Domingo, a 30\u00ba Cross dos Cavaleiros de Vale de Santiago, e a 16\u00ba Percurso Pedestre dos Cavaleiros. Em simult\u00e2neo realiza-se o XXVIII Campeonato do Alentejo de Corta Mato da responsabilidade da Associa\u00e7\u00e3o de Atletismo de Beja, \u00c9vora e Portalegre.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":45979,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,478,624],"event_type_2":[728,44],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-45978","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-odemira-beja","event_type-caminhada","event_type-corrida","event_type-corridas-inferior-10","event_type-kids","event_type_2-algarve-e-sul","event_type_2-beja"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/10\/68fb44cb42a50_c