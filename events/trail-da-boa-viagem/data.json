{"id":50155,"date":"2026-03-26T12:33:09","date_gmt":"2026-03-26T11:33:09","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=50155"},"modified":"2026-08-23T21:44:29","modified_gmt":"2026-08-23T20:44:29","slug":"trail-da-boa-viagem","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-da-boa-viagem\/","title":{"rendered":"Trail da Boa Viagem 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O <strong>IV Trail da Boa Viagem<\/strong> realiza-se no dia <strong>7 de junho de 2026<\/strong> <strong>em Contige, S\u00e1t\u00e3o (Viseu)<\/strong>. Este evento de <strong>trail running<\/strong> percorre os trilhos t\u00e9cnicos e caminhos rurais da regi\u00e3o de S\u00e1t\u00e3o, oferecendo habitualmente tr\u00eas dist\u00e2ncias: <strong>Trail <\/strong>, <strong>Mini-Trail <\/strong>e uma <strong>Caminhada <\/strong>. A sua caracter\u00edstica \u00fanica \u00e9 o ambiente de grande proximidade e hospitalidade da comunidade local de Contige, com um percurso que atravessa zonas de pinhal e granito t\u00edpicas da Beira Alta, apresentando um desn\u00edvel moderado ideal para a inicia\u00e7\u00e3o ao trail no m\u00eas de maio.<\/p>\n\n\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":50156,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[726,820,102],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-50155","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-satao-viseu","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-porto-e-norte","event_type_2-portugal","event_type_2-viseu"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/03\/69c4f4cfc1c1a_cartaz_net-cartaz_46