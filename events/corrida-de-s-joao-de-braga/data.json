{"id":47635,"date":"2026-01-02T12:21:34","date_gmt":"2026-01-02T11:21:34","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/corrida-de-s-joao-de-braga\/"},"modified":"2026-08-23T22:14:25","modified_gmt":"2026-08-23T21:14:25","slug":"corrida-de-s-joao-de-braga","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-de-s-joao-de-braga\/","title":{"rendered":"Corrida S. Jo\u00e3o de Braga 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A <strong>Corrida de S. Jo\u00e3o de Braga 2026<\/strong> celebra-se a 21 de junho de 2026, com partida e chegada na <strong>Avenida Central, em Braga<\/strong>. Este evento emblem\u00e1tico de <strong>estrada<\/strong> faz parte das festividades sanjoaninas da cidade, oferecendo uma <strong>Corrida de 10 km<\/strong> cronometrada e uma <strong>Caminhada de 5 km<\/strong> sem fins competitivos. A sua caracter\u00edstica \u00fanica \u00e9 o ambiente festivo e popular que envolve o percurso pelo centro hist\u00f3rico de Braga, sendo uma das provas noturnas (habitualmente ao final do dia) mais participadas do Norte de Portugal, caracterizada por um tra\u00e7ado maioritariamente plano e r\u00e1pido em pleno m\u00eas de junho.<\/p>\n","protected":false},"author":1,"featured_media":50143,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28,478],"event_type_2":[52,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-47635","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-braga","event_organizer-runporto","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type-corridas-inferior-10","event_type_2-braga","event_type_2-porto-e-norte","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/01\/download-2.jpg","ams_acf":[],"_lin