{"id":46000,"date":"2025-10-25T10:10:54","date_gmt":"2025-10-25T09:10:54","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=46000"},"modified":"2026-08-23T23:26:17","modified_gmt":"2026-08-23T22:26:17","slug":"corrida-dos-restauradores-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-dos-restauradores-2025\/","title":{"rendered":"Corrida dos Restauradores 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A Corrida dos Restauradores celebra uma das seculares tradi\u00e7\u00f5es do Fund\u00e3o, a Arruada do 1.\u00ba de Dezembro.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Todos os anos, \u00e0s 00h00 do dia 01 de dezembro, os locais re\u00fanem-se em surdina na Pra\u00e7a do Munic\u00edpio e percorrem as ruas com o prop\u00f3sito de &#8220;correr os espanh\u00f3is&#8221;, numa clara alus\u00e3o aos acontecimentos de 1640.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u00c9 uma corrida de estrada popular, noturna, caracterizada pelo percurso citadino que percorre algumas das mais emblem\u00e1ticas ruas e art\u00e9rias da cidade do Fund\u00e3o.<\/p>\n\n\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":46001,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,28,624],"event_type_2":[535,727],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-46000","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-fundao-castelo-branco","event_type-corrida","event_type-corrida-10-km","event_type-kids","event_type_2-castelo-branco","event_type_2-lisboa-e-centro"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/10\/RESTAURADORES_2025_Cartaz.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/