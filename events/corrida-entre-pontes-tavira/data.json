255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Corrida Jovem<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Corrida Jovens Sub16 e Sub18 (1.920m)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 20 Set \u2022 \u23f0 Partida: 09:50<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Forma\u00e7\u00e3o:<\/strong> 0.00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e9 15 Set)<\/span><\/div>\n<\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Corrida Jovem<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Corrida Jovens Sub12 e Sub14 (1.100m)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 20 Set \u2022 \u23f0 Partida: 09:35<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Forma\u00e7\u00e3o:<\/strong> 0.00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e