; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Qual \u00e9 o tempo limite da prova de 21 km?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O tempo limite de conclus\u00e3o da Meia Maratona \u00e9 de 2 horas e 45 minutos.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"Meia Maratona Enzo Ferrari 2027\", \"startDate\": \"2027-03-14\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Maranello, It\u00e1lia\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Maranello\", \"addressRegion\": \"Europa\", \"addressCountry\": \"IT\"}}, \"organizer\": {\"@type\": \"Organization\", \"name\": \"Mezza Maratona d'Italia (Memorial Enzo Ferrari)\"}}<\/script><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Quando e onde se realiza a Meia Maratona Enzo Ferrari 2027?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A prova realiza-se no domingo, 14 de mar\u00e7o de 2027, com partida e chegada no centro de Maranello, junto aos complexos hist\u00f3ricos da Ferrari, em It\u00e1lia.\"}}, {\"@type\": \"Question\", \"name\": \"Quais s\u00e3o as dist\u00e2ncias dispon\u00edveis no evento?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O evento disp\u00f5e de tr\u00eas modalidades: Meia Maratona de 21,097 km, prova de 10 km e caminhada familiar de 5 km.\"}}, {\"@type\": \"Question\", \"name\": \"O percurso passa pelo Museu Ferrari?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \