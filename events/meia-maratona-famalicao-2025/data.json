{"id":38635,"date":"2024-11-30T20:25:52","date_gmt":"2024-11-30T19:25:52","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=38635"},"modified":"2026-08-23T23:29:07","modified_gmt":"2026-08-23T22:29:07","slug":"meia-maratona-famalicao-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-famalicao-2025\/","title":{"rendered":"Meia Maratona Famalic\u00e3o 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">No dia 19 de outubro de 2025, \u00e0s 09h30, realiza-se a 11\u00aa Meia Maratona de Famalic\u00e3o, a prova que promete voltar a encher as ruas da cidade com energia e entusiasmo.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A partida ser\u00e1 dada na Avenida do Brasil e a meta estar\u00e1 instalada no Parque de Estacionamento junto ao CITEVE.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Al\u00e9m da dist\u00e2ncia rainha de 21 km, o evento contar\u00e1 tamb\u00e9m com uma corrida\/caminhada de 10 km, ideal para quem prefere um desafio mais leve, mas igualmente envolvente.&nbsp;<\/p>\n","protected":false},"author":1,"featured_media":45834,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,28,41],"event_type_2":[52,726],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-38635","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-famalicao-porto","event_organizer-runporto","event_type-corrida","event_type-corrida-10-km","event_type-meiamaratona","event_type_2-braga","event_type_2-porto-e-norte"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2024\/11\/200x100.jpg.200x0_q95.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/38635","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-