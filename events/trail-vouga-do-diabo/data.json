{"id":48604,"date":"2026-02-02T12:54:14","date_gmt":"2026-02-02T11:54:14","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=48604"},"modified":"2026-08-23T22:53:59","modified_gmt":"2026-08-23T21:53:59","slug":"trail-vouga-do-diabo","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-vouga-do-diabo\/","title":{"rendered":"Trail Vouga do Diabo 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O Trail Vouga do Diabo \u00e9 um evento de trail running organizado pela equipa ASCR Mosteirinho Runners.<br>A prova ir\u00e1 decorrer na freguesia de Pinho, concelho de S\u00e3o Pedro do Sul, tendo como lugar de partida<br>e chegada a sede da ASCR Mosteirinho, localizada na Rua do Corti\u00e7o, Edif\u00edcio da Escola Prim\u00e1ria em<br>Mosteirinho.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><br>Este evento conta com o apoio da ASCR Mosteirinho, do Munic\u00edpio de S. Pedro do Sul, da Junta de<br>Freguesia de Pinho e de Associa\u00e7\u00f5es\/Empresas locais e integra tr\u00eas provas: Trail Longo (26 km), Trail<br>Curto (15 km) e caminhada (11 km).<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":48605,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[726,820,102],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-48604","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-sao-pedro-do-sul-viseu","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-porto-e-norte","event_type_2-portugal","event_type_2-viseu"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/02\/6978c91d3d558_cartaz_trail_vouga_diabo_net-cartaz_460.jp