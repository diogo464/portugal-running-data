{"id":43915,"date":"2025-08-09T14:46:12","date_gmt":"2025-08-09T13:46:12","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/almodovar-night-run-2025\/"},"modified":"2026-08-23T23:54:19","modified_gmt":"2026-08-23T22:54:19","slug":"almodovar-night-run-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/almodovar-night-run-2025\/","title":{"rendered":"Almod\u00f4var Night Run 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">\u00c9 um evento de corrida e caminhada organizado pela Associa\u00e7\u00e3o Casa do Sport Lisboa e Benfica em Almod\u00f4var com o intuito de promover a modalidade na regi\u00e3o e poder proporcionar aos participantes um percurso diferente e de uma beleza \u00fanica nos caminhos no interior da Vila de Almod\u00f4var A Caminhada n\u00e3o competitiva inicia-se \u00e0s 18h35m e \u00e9 antecedida de um aquecimento. Esta atividade tem a dist\u00e2ncia de 5,3Km (2 voltas ao circuito urbano piso misto) e ser\u00e1 guiada desde o local de partida at\u00e9 \u00e1 chegada.<br><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A Corrida &#8211; 8 km &#8211; (3 voltas ao circuito urbano piso misto), prova competitiva, inicia &#8211; se \u00e0s 18h30 com partida e chegada no mesmo local. Cada passagem apresenta uma dist\u00e2ncia de cerca de 2 650 m.<\/p>\n\n\n","protected":false},"author":1,"featured_media":43917,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,478],"event_type_2":[728,44],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-43915","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-almodovar-beja","event_type-caminhada","event_type-corrida","event_type-corridas-inferior-10","event_type_2-algarve-e-sul","event_type_2-beja"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/08\/68937