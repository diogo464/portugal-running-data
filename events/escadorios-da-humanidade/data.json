\u00e7\u00e3o individual baseia-se no menor tempo cronometrado na subida por escal\u00e3o et\u00e1rio (de Sub-25 a Veteranos VI). A classifica\u00e7\u00e3o coletiva resulta do somat\u00f3rio dos tr\u00eas melhores tempos de cada Corpo de Bombeiros participante.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":67735,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,478],"event_type_2":[52,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-67444","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_type-corrida","event_type-corridas-inferior-10","event_type_2-braga","event_type_2-porto-e-norte","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/cartaz-escadorios-da-humanidade-1.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/67444","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=67444"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/67444\/revisions"}],"predecessor-version":[{"id":67920,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/67444\/revisions\/67920"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/67735"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=67444"}],"wp:term":[{"taxonomy":"post_tag","embeddable":tru