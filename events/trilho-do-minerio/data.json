{"id":50060,"date":"2026-03-21T15:23:54","date_gmt":"2026-03-21T14:23:54","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=50060"},"modified":"2026-08-23T22:16:19","modified_gmt":"2026-08-23T21:16:19","slug":"trilho-do-minerio","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trilho-do-minerio\/","title":{"rendered":"Trilho do Min\u00e9rio 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O <strong>Trilho do Min\u00e9rio 2026<\/strong> realiza-se no dia <strong>28 de junho<\/strong>, na freguesia de <strong>Queir\u00e3 (Vouzela)<\/strong>, integrando a segunda edi\u00e7\u00e3o do circuito <em>Vouzela Epic Trails<\/em>. O evento percorre trilhos serranos e caminhos rurais do distrito de <strong>Viseu<\/strong>, oferecendo percursos de <strong>trail longo (20 km)<\/strong>, <strong>trail curto (10 km)<\/strong> e uma caminhada. A sua caracter\u00edstica \u00fanica \u00e9 a passagem pelas <strong>antigas minas de volfr\u00e2mio<\/strong> da regi\u00e3o, permitindo aos atletas correr num cen\u00e1rio de grande relev\u00e2ncia hist\u00f3rica e geol\u00f3gica, com um <strong>desn\u00edvel acumulado positivo<\/strong> que ronda os <strong>900m<\/strong> na dist\u00e2ncia principal, partindo e terminando no centro de Queir\u00e3.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":50061,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497],"event_type_2":[726,820,102],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-50060","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-queira-vouzela","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type_2-porto-e-norte","event_type_2-portugal","event_type_2-viseu"],"acf":[],"featured_image_src":"https:\/\/www.portug