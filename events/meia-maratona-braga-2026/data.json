{"id":54950,"date":"2026-07-23T23:24:34","date_gmt":"2026-07-23T22:24:34","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=54950"},"modified":"2026-08-23T21:15:46","modified_gmt":"2026-08-23T20:15:46","slug":"meia-maratona-braga-2026","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-braga-2026\/","title":{"rendered":"Meia Maratona Braga 2026"},"content":{"rendered":"\n<h2 class=\"wp-block-heading\" ><a href=\"https:\/\/www.runporto.com\/pt\/eventos\/meia-maratona-de-braga\/meia-maratona-de-braga-2026\/resultados\/\" target=\"_blank\" rel=\"noopener\">Resultados<\/a><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">A <strong>Meia Maratona de Braga<\/strong> (oficialmente Caravela Seguros Meia Maratona de Braga) \u00e9 uma prova de estrada realizada na cidade de <strong>Braga, Portugal<\/strong>. A pr\u00f3xima edi\u00e7\u00e3o est\u00e1 confirmada para <strong>29 de mar\u00e7o de 2026<\/strong>, com um percurso desenhado nas avenidas da cidade, conhecido por ser r\u00e1pido e plano. O evento disp\u00f5e da dist\u00e2ncia principal de <strong>21 km<\/strong> e de uma Mini Maratona\/Caminhada de <strong>6 km<\/strong>. A corrida destaca-se pela oportunidade de percorrer o cen\u00e1rio urbano hist\u00f3rico da &#8220;Cidade dos Arcebispos&#8221; com uma organiza\u00e7\u00e3o profissional a cargo da Runporto.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":48357,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[41,672,27,478],"event_type_2":[52,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-54950","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-braga","event_organizer-runporto","event_type-meiamaratona","event_type-caminhada","event_type-corrida","event_type-corridas-infe