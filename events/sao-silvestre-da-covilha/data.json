55, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\"><div style=\"flex: 1; min-width: 200px;\"><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Forma\u00e7\u00e3o \/ Kids<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Iniciados \u2013 Sub-16 (14 e 15 anos) (2,5 km)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 26 Dez \u2022 \u23f0 Partida: 20:25<\/span><\/div><div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\"><div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Inscri\u00e7\u00e3o Gratuita:<\/strong> Gratuito<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e9 21\/12\/2026)<\/span><\/div><\/div><\/div><div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\"><div style=\"flex: 1; min-width: 200px;\"><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Forma\u00e7\u00e3o \/ Kids<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Infantis \u2013 Sub-14 (12 e 13 anos) (1,5 km)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 26 Dez \u2022 \u23f0 Partida: 20:10<\/span><\/div><div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\"><div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Inscri\u00e7\u00e3o Gratuita:<\/strong> Gratuito<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e9 21\/12\/2026)<\/span><\/div><\/div><\/div><div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\"><div style=\"flex: 1; min-width: 200px;\"><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Forma\u00e7\u00e3o \/ Kids<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Benjamins \u2013 Sub-12 (at\u00e9 11 anos) (700 m)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 26 Dez \u2022 \u23f0 Partida: 20:00<\/span><\/div><div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\"><div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Inscri\u00e7\u00e3o Gratuita:<\/strong> Gratuito<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e9 21\/12\/2026)<\/span><\/div><\/div><\/div><\/div><\/div><\/ul><\/div><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\"><h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2><details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\"><summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quando e onde \u00e9 a partida e a chegada da S\u00e3o Silvestre da Covilh\u00e3 2026?<\/summary><div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A 46\u00aa Corrida de S\u00e3o Silvestre da Covilh\u00e3 realiza-se no s\u00e1bado, 26 de dezembro de 2026, a partir das 20:00 (com a corrida principal de 10 km \u00e0s 21:30). Todas as partidas e chegadas decorrem na Pra\u00e7a do Munic\u00edpio (Rua Ant\u00f3nio Augusto Aguiar), entre a Sede do Posto de Turismo da Covilh\u00e3 e a Caixa Geral de Dep\u00f3sitos (<a href=\"https:\/\/maps.app.goo.gl\/ddJPvCLSp36dq6Vz7\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: #38BDF8; text-decoration: underline;\">ver localiza\u00e7\u00e3o exata no Google Maps<\/a>).<\/div><\/details><details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\"><summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">As inscri\u00e7\u00f5es s\u00e3o gratuitas e como me posso inscrever at\u00e9 ao prazo limite?<\/summary><div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Sim, as inscri\u00e7\u00f5es s\u00e3o 100% gratuitas em todos os escal\u00f5es e est\u00e3o abertas a atletas federados, n\u00e3o federados e populares. Devem ser formalizadas at\u00e9 \u00e0s 24:00 do dia 21 de dezembro de 2026 junto da Associa\u00e7\u00e3o de Atletismo de Castelo Branco (e-mail cbranco@fpatletismo.org | tel. 272 341 753 \/ 962 293 927) ou do C.C.D. Le\u00f5es da Floresta (e-mail leoesdafloresta@gmail.com | tel. 275 323 931 \/ 968 902 200).<\/div><\/details><details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\"><summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quais s\u00e3o os hor\u00e1rios de partida, escal\u00f5es et\u00e1rios e dist\u00e2ncias oficiais?<\/summary><div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O programa compreende cinco partidas: \u00e0s 20:00 correm os Benjamins Sub-12 (nascidos em 2015 e seguintes, 700 m); \u00e0s 20:10 os Infantis Sub-14 (2013-2014, 1,5 km); \u00e0s 20:25 os Iniciados Sub-16 (2011-2012, 2,5 km); \u00e0s 20:50 os Juvenis Sub-18 (2009-2010, 4,5 km); e \u00e0s 21:30 parte a prova principal de 10 km englobando Juniores Sub-20 (2007-2008), Seniores (1992-2006), Veteranos 1 M35\/40 (1982-1991) e Veteranos 2 M45+ (nascidos at\u00e9 1981).<\/div><\/details><details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\"><summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde e a que horas funciona o secretariado para levantar os dorsais?<\/summary><div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A entrega dos dorsais tem in\u00edcio \u00e0s 19:00 (uma hora antes da primeira partida) no Secretariado da Prova, instalado na Sede do C.C.D. Le\u00f5es da Floresta (Rua Ant\u00f3nio Augusto Aguiar, n\u00ba 16, Covilh\u00e3, podendo ser deslocado para junto da partida\/meta). As equipas levantam os dorsais atrav\u00e9s de um delegado e os atletas individuais diretamente no local, devendo todos os participantes ser portadores do Cart\u00e3o de Cidad\u00e3o.<\/div><\/details><details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\"><summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Que pr\u00e9mios s\u00e3o atribu\u00eddos e quais s\u00e3o as regras de abastecimento no percurso?<\/summary><div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Todos os atletas inscritos recebem uma lembran\u00e7a de participa\u00e7\u00e3o ao cruzar a meta e contam com Seguro de Acidentes Pessoais. H\u00e1 trof\u00e9us individuais (masculinos e femininos) e coletivos (equipas pontuando pelos 3 melhores atletas) para os tr\u00eas primeiros classificados de cada escal\u00e3o, exceto Benjamins, ficando os pr\u00e9mios monet\u00e1rios \u00e0 responsabilidade da organiza\u00e7\u00e3o. Nos termos regulamentares, n\u00e3o \u00e9 permitido acompanhamento externo nem rece\u00e7\u00e3o de abastecimento durante o decorrer da prova.<\/div><\/details><\/div><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"S\u00e3o Silvestre da Covilh\u00e3 2026\", \"startDate\": \"2026-12-26\", \"endDate\": \"2026-12-26\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Pra\u00e7a do Munic\u00edpio (entre o Posto de Turismo e a CGD)\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Covilh\u00e3\", \"addressRegion\": \"Castelo Branco\", \"addressCountry\": \"PT\"}}, \"description\": \"A S\u00e3o Silvestre da Covilh\u00e3 2026 corre-se a 26 de dezembro na Pra\u00e7a do Munic\u00edpio. Prova gratuita de 10 km e escal\u00f5es jovens desde 700 m. V\u00ea hor\u00e1rios e percurso!\", \"offers\": [{\"@type\": \"Offer\", \"name\": \"Corrida Principal \u2013 Juniores, Seniores e Veteranos\", \"price\": \"0\