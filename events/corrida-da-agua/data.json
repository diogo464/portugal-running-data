: \"Question\", \"name\": \"Onde posso consultar as classifica\u00e7\u00f5es e tempos oficiais?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As classifica\u00e7\u00f5es da Corrida de 10 km estar\u00e3o dispon\u00edveis na plataforma Xistarca e divulgadas no portal Portugal Running ap\u00f3s o t\u00e9rmino do evento.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":55163,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-55162","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-monsanto-lisboa","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/07\/CORRIDA-AGUA-032-750x380-1.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55162","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=55162"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55162\/revisions"}],"predecessor-version":[{"id":65635,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55162\/revisions\/65635"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/55163"}],"wp:attachment":[{"href":"https:\/