\": {\"@type\": \"Answer\", \"text\": \"As inscri\u00e7\u00f5es oficiais realizam-se online no portal oficial da Corrida Auchan atrav\u00e9s da hiperliga\u00e7\u00e3o dispon\u00edvel no Portugal Running.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":66163,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-51275","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-jamor-lisboa","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/corrida-auchan-2026.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51275","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=51275"}],"version-history":[{"count":4,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51275\/revisions"}],"predecessor-version":[{"id":65819,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51275\/revisions\/65819"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/66163"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=51275"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/ww