ada, a Associa\u00e7\u00e3o Vale Grande oferece a todos os participantes um conv\u00edvio festivo de encerramento com porco no espeto e imperial.\"}}, {\"@type\": \"Question\", \"name\": \"O que inclui o kit de atleta?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O kit contempla t-shirt t\u00e9cnica unissexo oficial, dorsal personalizado com chip eletr\u00f3nico de cronometragem (para as corridas) e abastecimentos de percurso e meta.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":68113,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28,478,624],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-51618","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-odivelas-lisboa","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type-corridas-inferior-10","event_type-kids","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/cartaz-grande-premio-do-vale-grande.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51618","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=51618"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51618\/revisions"}],"predecessor-version":[{"id":68117,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2