 no portal zuerichmarathon.ch, com acompanhamento de dicas e novidades no Portugal Running.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":57918,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,28,31,41],"event_type_2":[627,1510],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-57917","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-zurique-suica","event_type-corrida","event_type-corrida-10-km","event_type-maratona","event_type-meiamaratona","event_type_2-europa","event_type_2-suica"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/08\/web_zuerich_MarathonZurich_wide_01.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/57917","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=57917"}],"version-history":[{"count":2,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/57917\/revisions"}],"predecessor-version":[{"id":66086,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/57917\/revisions\/66086"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/57918"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=57917"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/tags?post=57917"},{"taxonomy":"event_type","embeddable":true,"h