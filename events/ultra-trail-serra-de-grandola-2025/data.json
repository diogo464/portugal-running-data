{"id":43127,"date":"2025-07-14T07:43:37","date_gmt":"2025-07-14T06:43:37","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=43127"},"modified":"2026-08-23T23:23:56","modified_gmt":"2026-08-23T22:23:56","slug":"ultra-trail-serra-de-grandola-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/ultra-trail-serra-de-grandola-2025\/","title":{"rendered":"Ultra Trail Serra de Gr\u00e2ndola 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O Ultra Trail Serra de Gr\u00e2ndola (UTSG) \u00e9 um evento competitivo de trail running, organizado pelo Munic\u00edpio<br>de Gr\u00e2ndola e pelo Clube Amiciclo, com o apoio do movimento associativo do concelho.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">As competi\u00e7\u00f5es decorrem maioritariamente por trilhos e caminhos existentes na Serra de Gr\u00e2ndola em tr\u00eas<br>dist\u00e2ncias: 46 km, 26 km e 13,5 km. Simultaneamente realizar-se-\u00e1 uma Caminhada com 11 km.<\/p>\n\n\n\n<ul class=\"wp-block-list\" >\n<li>Trail Ultra 46 km | D+ 2500m | Grau 3<\/li>\n\n\n\n<li>Trail Sprint 26 km | D+ 1350m | Grau 3<\/li>\n\n\n\n<li>Mini Trail 13,5 km |D+ 500m | Grau 2<\/li>\n\n\n\n<li>Caminhada 11 km |D+ 300m<\/li>\n<\/ul>\n","protected":false},"author":1,"featured_media":43128,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[22,672,497,498,499],"event_type_2":[48,728],"event_type_3":[],"event_type_4":[],"event_type_5":[823],"class_list":["post-43127","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-grandola-setubal","event_type-trail","event_type-caminhada","event_type-trail-curto","event_type-trail-longo","event_type-trail-ultra","event_type_2-setubal","event_type_2-algarve-e-sul","event_type_5-circuito-atrp"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/07\/686fca3