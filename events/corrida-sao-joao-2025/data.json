{"id":38629,"date":"2024-11-30T20:23:08","date_gmt":"2024-11-30T19:23:08","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=38629"},"modified":"2026-08-24T06:59:17","modified_gmt":"2026-08-24T05:59:17","slug":"corrida-sao-joao-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-sao-joao-2025\/","title":{"rendered":"Corrida S\u00e3o Jo\u00e3o 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Realiza-se no dia 15 de junho de 2025, pelas 9h00, na Cidade de Vila Nova de Gaia, com partidas e chegadas na Zona Pedonal de Canidelo, a Continental Corrida de S\u00e3o Jo\u00e3o.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A prova inclui uma corrida cronometrada de 10 km e uma caminhada de 7 km, sem fins competitivos.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Esta \u00e9 a oportunidade perfeita para celebrar o esp\u00edrito festivo do S\u00e3o Jo\u00e3o de uma forma ativa e divertida.<\/p>\n","protected":false},"author":1,"featured_media":42525,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28,478],"event_type_2":[52,726],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-38629","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-porto","event_organizer-runporto","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type-corridas-inferior-10","event_type_2-braga","event_type_2-porto-e-norte"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2024\/11\/sjoaogaia25_200x100.jpg.200x0_q95.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/38629","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugal