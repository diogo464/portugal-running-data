cri\u00e7\u00e3o oficial?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As inscri\u00e7\u00f5es oficiais decorrem online no portal oficial athensauthenticmarathon.gr, com guia e dicas essenciais no Portugal Running.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":66303,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,28,31],"event_type_2":[627,1472],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-47299","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-atenas-grecia","event_type-corrida","event_type-corrida-10-km","event_type-maratona","event_type_2-europa","event_type_2-grecia"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/43-maratona-de-atenas-autentica-2026.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/47299","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=47299"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/47299\/revisions"}],"predecessor-version":[{"id":66108,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/47299\/revisions\/66108"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/66303"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=47299"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"http