{"id":44265,"date":"2025-09-02T08:10:01","date_gmt":"2025-09-02T07:10:01","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=44265"},"modified":"2026-08-23T23:10:51","modified_gmt":"2026-08-23T22:10:51","slug":"sao-silvestre-tondela","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/sao-silvestre-tondela\/","title":{"rendered":"S\u00e3o Silvestre Tondela 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A 1\u00aa S\u00e3o Silvestre de Tondela, realizar-se-\u00e1 no dia 3 de janeiro de 2026, com sa\u00edda e chegada no Parque Urbano de Tondela pelas 18h00m.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A corrida ter\u00e1 a dist\u00e2ncia de 10 KM num percurso \u201ccircular\u201d com a dist\u00e2ncia de 5 KM. O participante que participar na corrida dever\u00e1 completar duas voltas ao percurso estipulado e devidamente marcado. A modalidade de caminhada conta com a dist\u00e2ncia de 5 KM o que corresponde ao mesmo percurso.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":44266,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,28,47],"event_type_2":[726,102],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-44265","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-tondela-viseu","event_type-corrida","event_type-corrida-10-km","event_type-sao-silvestre","event_type_2-porto-e-norte","event_type_2-viseu"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/09\/68a496bab5548_cartaz-cartaz_460.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/44265","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href