{"id":50692,"date":"2026-04-18T09:46:44","date_gmt":"2026-04-18T08:46:44","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=50692"},"modified":"2026-08-23T22:00:58","modified_gmt":"2026-08-23T21:00:58","slug":"corrida-de-sao-pedro","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-de-sao-pedro\/","title":{"rendered":"Corrida de S\u00e3o Pedro 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A XXXVI Corrida de S. Pedro 2026, \u00e9 uma prova do Calend\u00e1rio Nacional da F.P.A., coorganizada pelo CDC Navais e o PELOURO DO DESPORTO DA C\u00c2MARA MUNICIPAL DA P\u00d3VOA DE VARZIM, com a colabora\u00e7\u00e3o da BIKESERVICE, da Associa\u00e7\u00e3o de Atletismo do Porto e do Conselho Regional de Arbitragem.<br><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A Corrida de S. Pedro 2026, realiza-se no dia 5 de julho, com a prova de 10km a ter in\u00edcio \u00e0s 10h; e tem no seu programa uma caminhada \u201c\u00c9 Bom Viver Aqui\u201d, com 5km 100% solid\u00e1ria a reverter a favor dos Bombeiros Volunt\u00e1rios P\u00f3voa de Varzim.<\/p>\n","protected":false},"author":1,"featured_media":50693,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28],"event_type_2":[24,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-50692","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-povoa-de-varzim-porto","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type_2-porto","event_type_2-porto-e-norte","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/04\/69e19f3f06a0f_logo-1024x1024.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/50692","targetHints":{"allow":["GET"]}}],"co