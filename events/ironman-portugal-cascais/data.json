\", \"name\": \"Onde posso realizar a inscri\u00e7\u00e3o oficial?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As inscri\u00e7\u00f5es oficiais decorrem no portal internacional do The IRONMAN Group .\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":66901,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,1456,31,41],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-50515","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-cascais-lisboa","event_type-corrida","event_type-ironman-triatlo","event_type-maratona","event_type-meiamaratona","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/ironman-portugal-cascais-2026-1024x444.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/50515","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=50515"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/50515\/revisions"}],"predecessor-version":[{"id":65905,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/50515\/revisions\/65905"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/66901"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=50515"}],"wp:ter