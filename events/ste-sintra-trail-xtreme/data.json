.\"}}, {\"@type\": \"Question\", \"name\": \"Onde posso consultar o regulamento e fazer a inscri\u00e7\u00e3o?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O regulamento completo em PDF e as inscri\u00e7\u00f5es oficiais est\u00e3o dispon\u00edveis online atrav\u00e9s da plataforma Stop and Go.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":67631,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,624,22,497,739,498],"event_type_2":[728,33,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-51724","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-sintra-lisboa","event_type-caminhada","event_type-kids","event_type-trail","event_type-trail-curto","event_type-kids-trail","event_type-trail-longo","event_type_2-algarve-e-sul","event_type_2-lisboa","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/cartaz-ste-sintra-trail-xtreme.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51724","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=51724"}],"version-history":[{"count":4,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51724\/revisions"}],"predecessor-version":[{"id":67632,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/51724\/revisions\/67632"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp