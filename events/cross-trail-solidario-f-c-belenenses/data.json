p, abastecimentos, seguro e lembran\u00e7as.\"}}, {\"@type\": \"Question\", \"name\": \"Onde e at\u00e9 quando posso efetuar a inscri\u00e7\u00e3o?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As inscri\u00e7\u00f5es realizam-se atrav\u00e9s do portal Recorde Pessoal (recordepessoal.pt) at\u00e9 \u00e0s 24h00 do dia 1 de novembro de 2026 ou at\u00e9 esgotarem as 400 vagas.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":51257,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497],"event_type_2":[38,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-48234","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-marinha-grande-leiria","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type_2-leiria","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/01\/pop_a7ws4s5914.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/48234","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=48234"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/48234\/revisions"}],"predecessor-version":[{"id":65645,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/48234\/revisions\/65645"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/m