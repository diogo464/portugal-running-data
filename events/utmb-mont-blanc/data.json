, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Trail<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">OCC (Final Mundial 50K)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 26 Ago \u2022 \u23f0 Partida: 08:15<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">185.00 \u20ac<\/span><\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Trail<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">TDS (Sur les Traces des Ducs de Savoie)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 23 Ago \u2022 \u23f0 Partida: 23:59<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">310.00 \u20ac<\/span><\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Trail<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">ETC (Experience Trail Courmayeur)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 24 Ago \u2022 \u23f0 Partida: 14:00<\/span><\/div>\n<div style=\"text-align: right;\"><span style=\"color: #34D399; font-weight: 700; font-size: 15px; background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(52, 211, 153, 0.2); display: inline-block;\">55.00 \u20ac<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/ul>\n<\/div>\n<p><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><\/p>\n<div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\">\n<h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quando e onde se realiza o UTMB Mont-Blanc 2027?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O evento realiza-se de 23 a 29 de agosto de 2027, com partida e chegada na Place du Triangle de l&#8217;Amiti\u00e9, no centro de Chamonix, em Fran\u00e7a.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quais s\u00e3o as principais dist\u00e2ncias em disputa nas finais mundiais?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">As provas rainha s\u00e3o o UTMB (171 km e +10.000m D+), a CCC (100 km e +6.100m D+) e a OCC (55 km e +3.500m D+), complementadas pela TDS, PTL, MCC, YCC e ETC.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Como posso qualificar-me para o sorteio do UTMB Mont-Blanc?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A participa\u00e7\u00e3o requer a acumula\u00e7\u00e3o de Running Stones obtidas em provas do circuito UTMB World Series e um UTMB Index v\u00e1lido na categoria pretendida.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde posso consultar o regulamento oficial e percursos?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O regulamento completo e perfis de altimetria est\u00e3o dispon\u00edveis no portal oficial em https:\/\/montblanc.utmb.world\/.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Qual \u00e9 o tempo limite da prova principal do UTMB?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O tempo limite oficial para completar os 171 km e 10.000 metros de desn\u00edvel positivo \u00e9 de 46 horas e 30 minutos.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"UTMB Mont-Blanc 2027\", \"startDate\": \"2027-08-23\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Chamonix, Fran\u00e7a\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Chamonix\", \"addressRegion\": \"Europa\", \"addressCountry\": \"FR\"}}, \"organizer\": {\"@type\": \"Organization\", \"name\": \"UTMB Group\"}}<\/script><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Quando e onde se realiza o UTMB Mont-Blanc 2027?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O evento realiza-se de 23 a 29 de agosto de 2027, com partida e chegada na Place du Triangle de l'Amiti\u00e9, no centro de Chamonix, em Fran\u00e7a.\"}}, {\"@type\": \"Question\", \"name\": \"Quais s\u00e3o as principais dist\u00e2ncias em disputa nas finais mundiais?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As provas rainha s\u00e3o o UTMB (171 km e +10.000m D+), a CCC (100 km e +6.100m D+) e a OCC (55 km e +3.500m D+), complementadas pela TDS, PTL, MCC, YCC e ETC.\"}}, {\"@type\": \"Question\", \"name\": \"Como posso qualificar-me para o sorteio do UTMB Mont-Blanc?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A participa\u00e7\u00e3o requer a acumula\u00e7\u00e3o de Running Stones obtidas em provas do circuito UTMB World Series e um UTMB Index v\u00e1lido na categoria pretendida.\"}}, {\"@type\": \"Question\", \"name\": \"Onde posso consultar o regulamento oficial e percursos?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O regulamento completo e perfis de altimetria est\u00e3o dispon\u00edveis no portal oficial em https:\/\/montblanc.utmb.world\/.\"}}, {\"@type\": \"Question\", \"name\": \"Qual \u00e9 o tempo limite da prova principal do UTMB?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O tempo limite oficial para completar os 171 km e 10.000 metros de desn\u00edvel positivo \u00e9 de 46 horas e 30 minutos.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":68886,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[22,497,622,498,499],"event_type_2":[627,1439],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-68885","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-chamonix-franca","event_type-trail","event_type-trail-curto","event_type-trail-endurance","event_type-trail-longo","event_type-trail-ultra","event_type_2-europa","event_type_2-franca"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/cartaz-utmb-mont-blanc.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/68885","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/