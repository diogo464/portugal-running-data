00e7os est\u00e3o inclu\u00eddos na inscri\u00e7\u00e3o?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A inscri\u00e7\u00e3o inclui dorsal personalizado, chip eletr\u00f3nico (na corrida de 10 km), medalha de finalista, abastecimentos, seguro desportivo e servi\u00e7o de bengaleiro na zona de partida.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":68937,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28,624],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[811],"event_type_5":[],"class_list":["post-55219","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-lisboa","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type-kids","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal","event_type_4-solidaria-sim"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/cartaz-corrida-solidariedade-apav-1.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55219","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=55219"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55219\/revisions"}],"predecessor-version":[{"id":69066,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/55219\/revisions\/69066"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/689