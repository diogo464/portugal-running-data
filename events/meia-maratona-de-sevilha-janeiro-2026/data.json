{"id":46453,"date":"2025-11-09T12:37:26","date_gmt":"2025-11-09T11:37:26","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-de-sevilha-2026\/"},"modified":"2026-08-23T22:30:46","modified_gmt":"2026-08-23T21:30:46","slug":"meia-maratona-de-sevilha-janeiro-2026","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/meia-maratona-de-sevilha-janeiro-2026\/","title":{"rendered":"Meia Maratona de Sevilha 2026"},"content":{"rendered":"\n<h2 class=\"wp-block-heading\" ><a href=\"https:\/\/sportmaniacs.com\/es\/races\/medio-maratn-de-sevilla-2026#results\" target=\"_blank\" rel=\"noopener\">Resultados 2026<\/a><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">A&nbsp;<strong>Meia Maratona de Sevilha<\/strong>&nbsp;(Medio Marat\u00f3n de Sevilla) realiza-se no dia&nbsp;<strong>25 de janeiro de 2026<\/strong>&nbsp;e \u00e9 conhecida como&nbsp;<strong>a meia maratona mais plana da Europa<\/strong>, ideal para alcan\u00e7ar recordes pessoais. O percurso de&nbsp;<strong>21,097 km<\/strong>&nbsp;tem partida e chegada no&nbsp;<strong>Paseo de las Delicias<\/strong>, \u00e0s 9h00, e passa por monumentos ic\u00f3nicos como o Rio Guadalquivir, Parque de Mar\u00eda Luisa e o centro hist\u00f3rico de Sevilha. O tra\u00e7ado caracteriza-se por poucos desn\u00edveis e curvas, tornando-o extremamente r\u00e1pido, com temperaturas amenas entre&nbsp;<strong>9 e 13\u00b0C<\/strong>&nbsp;t\u00edpicas do inverno sevilhano.<\/p>\n\n\n","protected":false},"author":1,"featured_media":46455,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,41],"event_type_2":[809,627],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-46453","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-sevilha-espanha","event_type-corrida","event_type-meiamaratona","event_type_2-espanha","event_type_2-europa"],"acf":[