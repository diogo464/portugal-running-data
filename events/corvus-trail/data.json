erliga\u00e7\u00e3o oficial disponibilizada na p\u00e1gina do evento.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":68358,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,624,22,497,739,498],"event_type_2":[727,820,39],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-68242","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-abrantes-santarem","event_type-caminhada","event_type-kids","event_type-trail","event_type-trail-curto","event_type-kids-trail","event_type-trail-longo","event_type_2-lisboa-e-centro","event_type_2-portugal","event_type_2-santarem"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/cartaz-corvus-trail-1.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/68242","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=68242"}],"version-history":[{"count":4,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/68242\/revisions"}],"predecessor-version":[{"id":68782,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/68242\/revisions\/68782"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/68358"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=68242"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/tags?post