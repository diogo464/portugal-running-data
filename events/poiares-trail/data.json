rsal com chip, seguro desportivo, abastecimentos l\u00edquidos e s\u00f3lidos, transferes para a partida dos 35K e zonas de transi\u00e7\u00e3o das estafetas, pr\u00e9mio finisher, banhos e refei\u00e7\u00e3o quente no final do evento.\"}}]}<\/script>","protected":false},"author":1,"featured_media":69609,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[37,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-69608","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-vila-nova-de-poiares-coimbra","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-coimbra","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/10\/cartaz-poiares-trail.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/69608","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=69608"}],"version-history":[{"count":4,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/69608\/revisions"}],"predecessor-version":[{"id":70983,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/69608\/revisions\/70983"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/69609"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=69608"}],"