\"name\": \"Onde posso realizar a inscri\u00e7\u00e3o oficial e consultar o regulamento?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As inscri\u00e7\u00f5es oficiais decorrem online na plataforma Stop&Go at\u00e9 \u00e0s 23h59 de 2 de outubro de 2026, com todas as informa\u00e7\u00f5es t\u00e9cnicas e atualiza\u00e7\u00f5es dispon\u00edveis no Portugal Running.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":67189,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,739,498,499],"event_type_2":[38,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-46044","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-castanheira-de-pera","event_location-castanheira-de-pera-leiria","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-kids-trail","event_type-trail-longo","event_type-trail-ultra","event_type_2-leiria","event_type_2-lisboa-e-centro","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/axtrail.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/46044","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=46044"}],"version-history":[{"count":3,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/46044\/revisions"}],"predecessor-version":[{"id":67191,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/46044\/revisions\