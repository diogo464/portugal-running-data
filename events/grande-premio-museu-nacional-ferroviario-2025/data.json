{"id":42625,"date":"2025-06-17T10:15:57","date_gmt":"2025-06-17T09:15:57","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=42625"},"modified":"2026-08-23T23:45:42","modified_gmt":"2026-08-23T22:45:42","slug":"grande-premio-museu-nacional-ferroviario-2025","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/grande-premio-museu-nacional-ferroviario-2025\/","title":{"rendered":"Grande Pr\u00e9mio Museu Nacional Ferrovi\u00e1rio 2025"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A C\u00e2mara Municipal do Entroncamento, com o apoio t\u00e9cnico do Clube de Lazer, Aventura e Competi\u00e7\u00e3o do Entroncamento (CLAC-Entroncamento), organiza o XXVIII Grande Pr\u00e9mio Museu Nacional Ferrovi\u00e1rio, a realizar-se no dia 21 de setembro de 2025, a partir das 10h00, no concelho do Entroncamento.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">O evento inclui:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">&#8211; Corrida de estrada com 10 km (10.000 metros);<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">&#8211; 10.\u00aa Caminhada Jos\u00e9 Canelo, com aproximadamente 7 km, sem car\u00e1cter competitivo.<\/p>\n\n\n","protected":false},"author":1,"featured_media":42626,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28],"event_type_2":[727,39],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-42625","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-entroncamento-santarem","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type_2-lisboa-e-centro","event_type_2-santarem"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/06\/1750112646-1.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/42625","targetHints":{"al