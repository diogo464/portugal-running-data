{"id":46052,"date":"2025-10-25T11:12:03","date_gmt":"2025-10-25T10:12:03","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/hybrid-day-st-maria-da-feira-2026\/"},"modified":"2026-08-23T22:05:26","modified_gmt":"2026-08-23T21:05:26","slug":"hybrid-day-st-maria-da-feira","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/hybrid-day-st-maria-da-feira\/","title":{"rendered":"HYBRID DAY St Maria da Feira 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O castelo mais imponente de Portugal e a magia do Europarque v\u00e3o receber o Hybrid Day.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Nesta edi\u00e7\u00e3o, o Hybrid Day junta for\u00e7as com Feirenses, que assumem o compromisso de levar a tradi\u00e7\u00e3o e identidade local ao mais alto n\u00edvel.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">O Hybrid Day chega a Santa Maria da Feira para desafiar todos os Hybrid Athletes num dos maiores pavilh\u00f5es de Portugal.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Entre a hist\u00f3ria viva do castelo, as saborosas foga\u00e7as e os jardins envolventes do Europarque, est\u00e3o reunidos todos os ingredientes para um evento inesquec\u00edvel.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":46053,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[27,519],"event_type_2":[34,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-46052","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-santa-maria-da-feira-aveiro","event_type-corrida","event_type-obstaculos","event_type_2-aveiro","event_type_2-porto-e-norte","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2025\/10\/5cbd.jpg","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.