tos, medalha finisher (no Trail e Mini-Trail), duche, massagem e refei\u00e7\u00e3o de chegada.\"}}]}<\/script>","protected":false},"author":1,"featured_media":70176,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[726,820,102],"event_type_3":[],"event_type_4":[],"event_type_5":[823],"class_list":["post-54336","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-satao-viseu","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-porto-e-norte","event_type_2-portugal","event_type_2-viseu","event_type_5-circuito-atrp"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/10\/cartaz-trail-do-trabulo.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/54336","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=54336"}],"version-history":[{"count":5,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/54336\/revisions"}],"predecessor-version":[{"id":70855,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/54336\/revisions\/70855"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media\/70176"}],"wp:attachment":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/media?parent=54336"}],"wp:term":[{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/tags?post=5433