52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">\u00danica:<\/strong> 14,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Fecho de inscri\u00e7\u00f5es)<\/span><\/div>\n<\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Trail Curto<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">UPHILL Vouga (UPV)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 8 Jan \u2022 \u23f0 Partida: 20:00 \u2022 500m D+<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Fase 1:<\/strong> 10,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Lan\u00e7amento)<\/span><\/div>\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Fase 2:<\/strong> 15,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (\u00daltima fase)<\/span><\/div>\n<\/div>\n<\/div>\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Trail Kids<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Vouga Kids<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 10 Jan \u2022 \u23f0 Partida: 11:30<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Gratuita:<\/strong> 0,00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (Limite atingido)<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/ul>\n<\/div>\n<p><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><\/p>\n<div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\">\n<h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quando se realiza o Vouga Trail 2027 e onde decorre a partida?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O evento decorre de 8 a 10 de Janeiro de 2027, em Sever do Vouga, com arranque na sexta-feira \u00e0 noite com o UPHILL e partidas principais no centro da vila.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quais s\u00e3o as dist\u00e2ncias dispon\u00edveis no Vouga Trail 2027?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Podes optar pelo Vouga Trail Ultra (55 km), Vouga Trail Longo (35 km), Vouga Trail Curto (18 km), Vouga Trail Mini (12 km), Caminhada (10 km), UPHILL (4 km) e Vouga Kids.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde posso realizar a inscri\u00e7\u00e3o oficial para a prova?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">As inscri\u00e7\u00f5es s\u00e3o geridas oficialmente pela plataforma Stop &#038; Go no endere\u00e7o stopandgo.net\/events\/vouga-trail-2027.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">A prova integra circuitos oficiais de Trail Running?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Sim, as dist\u00e2ncias competitivas integram os circuitos oficiais de montanha da ATRP (Associa\u00e7\u00e3o de Trail Running de Portugal).<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Existe material obrigat\u00f3rio para as dist\u00e2ncias de Ultra e Longo?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Sim, para as dist\u00e2ncias de 55 km e 35 km \u00e9 obrigat\u00f3rio o uso de telem\u00f3vel operacional, manta t\u00e9rmica, apito, reservat\u00f3rio de \u00e1gua e casaco corta-vento imperme\u00e1vel.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"Vouga Trail 2027\", \"startDate\": \"2027-01-08\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Sever do Vouga, Aveiro\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Sever do Vouga\", \"addressRegion\": \"Aveiro\", \"addressCountry\": \"PT\"}}, \"organizer\": {\"@type\": \"Organization\", \"name\": \"AZTRAIL \/ Associa\u00e7\u00e3o Trilhos do Vouga\"}}<\/script><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Quando se realiza o Vouga Trail 2027 e onde decorre a partida?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O evento decorre de 8 a 10 de Janeiro de 2027, em Sever do Vouga, com arranque na sexta-feira \u00e0 noite com o UPHILL e partidas principais no centro da vila.\"}}, {\"@type\": \"Question\", \"name\": \"Quais s\u00e3o as dist\u00e2ncias dispon\u00edveis no Vouga Trail 2027?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Podes optar pelo Vouga Trail Ultra (55 km), Vouga Trail Longo (35 km), Vouga Trail Curto (18 km), Vouga Trail Mini (12 km), Caminhada (10 km), UPHILL (4 km) e Vouga Kids.\"}}, {\"@type\": \"Question\", \"name\": \"Onde posso realizar a inscri\u00e7\u00e3o oficial para a prova?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"As inscri\u00e7\u00f5es s\u00e3o geridas oficialmente pela plataforma Stop & Go no endere\u00e7o stopandgo.net\/events\/vouga-trail-2027.\"}}, {\"@type\": \"Question\", \"name\": \"A prova integra circuitos oficiais de Trail Running?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sim, as dist\u00e2ncias competitivas integram os circuitos oficiais de montanha da ATRP (Associa\u00e7\u00e3o de Trail Running de Portugal).\"}}, {\"@type\": \"Question\", \"name\": \"Existe material obrigat\u00f3rio para as dist\u00e2ncias de Ultra e Longo?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sim, para as dist\u00e2ncias de 55 km e 35 km \u00e9 obrigat\u00f3rio o uso de telem\u00f3vel operacional, manta t\u00e9rmica, apito, reservat\u00f3rio de \u00e1gua e casaco corta-vento imperme\u00e1vel.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":66867,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[22,672,497,739,498,499],"event_type_2":[34,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[823],"class_list":["post-44190","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-sever-do-vouga-aveiro","event_type-trail","event_type-caminhada","event_type-trail-curto","event_type-kids-trail","event_type-trail-longo","event_type-trail-ultra","event_type_2-aveiro","event_type_2-porto-e-norte","event_type_2-portugal","event_type_5-circuito-atrp"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/vouga-trail-2027.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/44190","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events