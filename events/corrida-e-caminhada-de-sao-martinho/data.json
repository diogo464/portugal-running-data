ada nesta p\u00e1gina.<\/div><\/details><\/div><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"3\u00aa Corrida e Caminhada de S\u00e3o Martinho 2026\", \"startDate\": \"2026-11-08\", \"endDate\": \"2026-11-08\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Faj\u00e3 Grande, Ilha das Flores,\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Faj\u00e3 Grande, Ilha das Flores,\", \"addressRegion\": \"A\u00e7ores\", \"addressCountry\": \"PT\"}}, \"description\": \"Guia do 3\u00aa Corrida e Caminhada de S\u00e3o Martinho 2026 a 8 de Novembro de 2026 em Acores. Consulta regulamento, percursos e inscri\u00e7\u00f5es oficiais!\", \"image\": [\"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/10\/cartaz-corrida-e-caminhada-de-sao-martinho.webp\"], \"offers\": [{\"@type\": \"Offer\", \"name\": \"Corrida 7500m\", \"price\": \"10.00\", \"priceCurrency\": \"EUR\", \"availability\": \"https:\/\/schema.org\/InStock\", \"url\": \"https:\/\/acorrer.pt\/eventos\/3-corrida-e-caminhada-de-sao-martinho\"}, {\"@type\": \"Offer\", \"name\": \"Corrida 5000m\", \"price\": \"10.00\", \"priceCurrency\": \"EUR\", \"availability\": \"https:\/\/schema.org\/InStock\", \"url\": \"https:\/\/acorrer.pt\/eventos\/3-corrida-e-caminhada-de-sao-martinho\"}, {\"@type\": \"Offer\", \"name\": \"Corrida 2500m\", \"price\": \"10.00\", \"priceCurrency\": \"EUR\", \"availability\": \"https:\/\/schema.org\/InStock\", \"url\": \"https:\/\/acorrer.pt\/eventos\/3-corrida-e-caminhada-de-sao-martinho\"}, {\"@type\": \"Offer\", \"name\": \"Caminhada 2500m\", \"price\": \"10.00\", \"priceCurrency\": \"EUR\", \"availability\": \"https:\/\/schema.org\/InStock\", \"url\": \"https:\/\/acorrer.pt\/eventos\/3-corrida-e-caminhada-de-sao-martinho\"}]}<\/script><