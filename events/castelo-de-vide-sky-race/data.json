 dist\u00e2ncias de 17 km e 12 km \u00e9 permitida a participa\u00e7\u00e3o de menores a partir dos 15 anos com declara\u00e7\u00e3o do encarregado de educa\u00e7\u00e3o.\"}}, {\"@type\": \"Question\", \"name\": \"Onde posso consultar o regulamento oficial e inscri\u00e7\u00f5es?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O regulamento oficial completo pode ser consultado na plataforma oficial do evento: https:\/\/www.turresevents.com\/eventos\/castelo-de-vide-sky-race-2026\/regulamento.\"}}]}<\/script><\/p>\n","protected":false},"author":1,"featured_media":69202,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[708,22,497,498],"event_type_2":[727,40,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-48327","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-castelo-de-vide-portalegre","event_type-skyrunning","event_type-trail","event_type-trail-curto","event_type-trail-longo","event_type_2-lisboa-e-centro","event_type_2-portalegre","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/10\/cartaz-castelo-de-vide-sky-race-683x1024.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/48327","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=48327"}],"version-history":[{"count":4,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/48327\/revisions"}],"predecessor-version":[{"id":69204,"href":"https: