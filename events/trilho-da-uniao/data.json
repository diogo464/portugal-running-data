wer\": {\"@type\": \"Answer\", \"text\": \"O recinto situa-se na EN 207-2, na Longra (Uni\u00e3o de Freguesias de Pedreira, Rande e Sernande, 4650-323 Felgueiras). Para informa\u00e7\u00f5es adicionais ou apoio \u00e0s inscri\u00e7\u00f5es, os participantes podem contactar Carlos Coelho pelo telefone 963 243 269 ou pelo email associacaociclturistasdefelgueiras@sapo.pt.\"}}]}<\/script><\/p>\n","protected":false},"author":535,"featured_media":67354,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22],"event_type_2":[24,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-67353","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-felgueiras-porto","event_location-sintra-lisboa","event_type-caminhada","event_type-trail","event_type_2-porto","event_type_2-porto-e-norte","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/09\/cartaz-trilho-da-uniao-724x1024.webp","ams_acf":[],"_links":{"self":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/67353","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events"}],"about":[{"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/types\/ajde_events"}],"author":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/users\/535"}],"replies":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/comments?post=67353"}],"version-history":[{"count":2,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/67353\/revisions"}],"predecessor-version":[{"id":67356,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/ajde_events\/67353\/revisions\/67356"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.portugalrunning.com\/wp-json\/wp\/v2\/medi