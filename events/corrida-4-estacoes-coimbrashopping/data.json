{"id":47848,"date":"2026-01-09T09:09:27","date_gmt":"2026-01-09T08:09:27","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=47848"},"modified":"2026-08-23T22:49:29","modified_gmt":"2026-08-23T21:49:29","slug":"corrida-4-estacoes-coimbrashopping","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-4-estacoes-coimbrashopping\/","title":{"rendered":"Corrida 4 Esta\u00e7\u00f5es CoimbraShopping 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A <strong>Corrida 4 Esta\u00e7\u00f5es CoimbraShopping 2026<\/strong> (Edi\u00e7\u00e3o de Inverno) \u00e9 um evento de estrada cl\u00e1ssico que se realiza na hist\u00f3rica cidade de <strong>Coimbra, Portugal<\/strong>. A prova est\u00e1 confirmada para o dia <strong>8 de mar\u00e7o<\/strong> (nova data) e oferece como dist\u00e2ncias principais os competitivos <strong>10 km<\/strong> e uma caminhada de <strong>5 km<\/strong>. O seu grande destaque \u00e9 o percurso panor\u00e2mico e praticamente plano que atravessa as duas pontes ic\u00f3nicas sobre o Rio Mondego (Ponte de Santa Clara e Ponte Rainha Santa Isabel), proporcionando vistas magn\u00edficas sobre a cidade universit\u00e1ria enquanto integra o conceituado circuito &#8220;4 Esta\u00e7\u00f5es&#8221; que promove o desporto na regi\u00e3o ao longo do ano.<\/p>\n","protected":false},"author":1,"featured_media":48872,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[28,672,27],"event_type_2":[37,727,820],"event_type_3":[],"event_type_4":[],"event_type_5":[1273],"class_list":["post-47848","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-coimbra","event_type-corrida-10-km","event_type-caminhada","event_type-corrida","event_type_2-coimbra","event_type_2-lisboa-e-centro","event_type_2-portugal","event_type_5-circuito-4-estacoes"],"acf":[],"featured_image_sr