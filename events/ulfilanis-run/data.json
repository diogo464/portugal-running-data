{"id":48697,"date":"2026-02-06T15:04:25","date_gmt":"2026-02-06T14:04:25","guid":{"rendered":"https:\/\/www.portugalrunning.com\/?post_type=ajde_events&#038;p=48697"},"modified":"2026-08-23T22:50:54","modified_gmt":"2026-08-23T21:50:54","slug":"ulfilanis-run","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/ulfilanis-run\/","title":{"rendered":"Ulfilanis Run 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A 7\u00aa ULFILANIS-RUN \u00e9 um evento a realizar no dia 12 de abril de 2026, organizado pela Junta de Freguesia de Fi\u00e3es e o Fi\u00e3es Sport Clube &#8211; Se\u00e7\u00e3o de Running em parceria com a C\u00e2mara Municipal de Santa Maria da Feira.<br>\u00c9 um evento desportivo com duas vertentes, uma Corrida (10K) com cariz competitivo destinada a atletas federados e n\u00e3o federados com idade igual ou superior a 18 anos no dia da prova; e uma Caminhada (6K) com cariz recreativo que permitir\u00e1 aos participantes partir da Quinta do Inspetor-Junta de Freguesia, na cidade de Fi\u00e3es, e percorrer as ruas daquela cidade em dire\u00e7\u00e3o aos id\u00edlicos Passadi\u00e7os do U\u00edma, regressando ao ponto de partida.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"author":1,"featured_media":48698,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28],"event_type_2":[34,726,820],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-48697","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-fiaes-santa-maria-da-feira","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type_2-aveiro","event_type_2-porto-e-norte","event_type_2-portugal"],"acf":[],"featured_image_src":"https:\/\/www.portugalrunning.com\/wp-content\/uploads\/2026\/02\/banner-ulfilanis-run-2026-min.jpg","ams_acf":[],"_links":{"self