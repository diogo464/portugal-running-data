{"id":36289,"date":"2024-07-14T13:42:33","date_gmt":"2024-07-14T12:42:33","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/trail-terras-de-sal-e-serra-2024\/"},"modified":"2026-08-24T09:52:52","modified_gmt":"2026-08-24T08:52:52","slug":"trail-terras-de-sal-e-serra-2024","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/trail-terras-de-sal-e-serra-2024\/","title":{"rendered":"Trail Terras de Sal e Serra 2024"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">O \u201c<strong><em>TRAIL TERRAS DE SAL E SERRA<\/em><\/strong>\u201d \u00e9 um conjunto de provas de trail running e caminhada, desenvolvidas ao longo de caminhos rurais, trilhos individuais e serra, com car\u00e1cter competitivo e l\u00fadico, que decorrer\u00e1 no dia 17 de Novembro de 2024, pelas 9 horas, em Rio Maior, distrito de Santar\u00e9m, com partida e chegada no Pavilh\u00e3o Multiusos de Rio Maior, e \u00e9 organizado em parceria pelo Munic\u00edpio de Rio Maior e pelo Clube do Mato.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>O evento \u00e9 constitu\u00eddo por quatro dist\u00e2ncias (n\u00fameros aproximados):<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Trail longo: 32 Km &#8211; 1240 D+<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Trail Curto: 18 Km &#8211; 630 D+<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Mini Trail: 11 Km &#8211; 240 D+<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Caminhada: 11 Km &#8211; 240 D+<\/p>\n\n\n","protected":false},"author":1,"featured_media":36290,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,22,497,498],"event_type_2":[727,39],"event_type_3":[],"event_type_4":[],"event_type_5":[],"class_list":["post-36289","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-rio-maior-santarem","event_type-caminhada","event_type-trail","event_type-trail-curto","event_type