55, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Caminhada<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Caminhada Mimosa Pela Vida 5 km (sem Chip)<\/strong><span style=\"color: #94A3B8; font-size: 13px; display: block; margin-top: 2px;\">\ud83d\udcc5 16 Mai \u2022 \u23f0 Partida: 10:30<\/span><\/div>\n<div style=\"text-align: right; background: rgba(52, 211, 153, 0.08); padding: 6px 12px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.2);\">\n<div style=\"color: #34D399; font-size: 12px; line-height: 1.4;\"><strong style=\"color: #A7F3D0;\">Inscri\u00e7\u00e3o sem Chip:<\/strong> 15.00 \u20ac<span style=\"color: #94A3B8; font-size: 11px;\"> (at\u00e9 15.000 vagas)<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/ul>\n<\/div>\n<p><!-- CARD 3: PERGUNTAS FREQUENTES (FAQS) --><\/p>\n<div class=\"pr-content-card\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; padding: 28px; margin-bottom: 24px;\">\n<h2 class=\"pr-card-title\" style=\"color: #FFFFFF; font-size: 22px; font-weight: 700; margin-bottom: 20px;\">\u2753 Perguntas <span class=\"pr-gradient-text\" style=\"background: linear-gradient(135deg, #C4B5FD 20%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;\">Frequentes (FAQ)<\/span><\/h2>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Quando e a que horas se realiza a Corrida Mimosa 2027?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O evento realiza-se no domingo, <strong>16 de Maio de 2027<\/strong>, com tiro de partida marcado para as <strong>10h30<\/strong>.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde fica o local de partida e a meta?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">A largada realiza-se em <strong>Santos<\/strong> (junto ao Kais) e a meta fica instalada junto \u00e0 <strong>Torre de Bel\u00e9m<\/strong>.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Qual \u00e9 a dist\u00e2ncia do percurso?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">O percurso tem a dist\u00e2ncia de <strong>5 km<\/strong>, sendo 100% plano e decorrendo ao longo da marginal do Rio Tejo (Av. Bras\u00edlia).<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">O evento tem cariz solid\u00e1rio?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">Sim, parte das receitas reverte anualmente a favor de causas solid\u00e1rias de apoio e preven\u00e7\u00e3o da sa\u00fade oncol\u00f3gica.<\/div>\n<\/details>\n<details class=\"pr-faq-item\" style=\"background: rgba(30, 41, 59, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 12px; padding: 16px 20px;\">\n<summary class=\"pr-faq-question\" style=\"color: #FFFFFF; font-weight: 600; font-size: 16px; cursor: pointer;\">Onde posso realizar a inscri\u00e7\u00e3o oficial?<\/summary>\n<div class=\"pr-faq-answer\" style=\"color: #CBD5E1; font-size: 15px; line-height: 1.6; margin-top: 12px;\">As inscri\u00e7\u00f5es realizam-se online no site oficial do <a href=\"https:\/\/maratonaclubedeportugal.com\/en\/corrida-mulher\/mimosa-corrida-pela-vida\/\" target=\"_blank\" rel=\"noopener\">Maratona Clube de Portugal<\/a>.<\/div>\n<\/details>\n<\/div>\n<p><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"SportsEvent\", \"name\": \"Corrida Mimosa 2027\", \"startDate\": \"2027-05-16\", \"eventAttendanceMode\": \"https:\/\/schema.org\/OfflineEventAttendanceMode\", \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"Santos (Partida) \u00e0 Torre de Bel\u00e9m (Meta), Lisboa\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Lisboa\", \"addressRegion\": \"Lisboa\", \"addressCountry\": \"PT\"}}, \"organizer\": {\"@type\": \"Organization\", \"name\": \"Maratona Clube de Portugal (MCP)\"}}<\/script><script type=\"application\/ld+json\" data-no-optimize=\"1\">{\"@context\": \"https:\/\/schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Quando e a que horas se realiza a Corrida Mimosa 2027?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"O evento realiza-se no domingo, 16 de Maio de 2027 , com tiro de partida marcado para as 10h30 .\"}}, {\"@type\": \"Question\", \"name\": \"Onde fica o local de partida e a meta?\