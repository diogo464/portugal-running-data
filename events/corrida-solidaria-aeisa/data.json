{"id":50764,"date":"2026-04-23T22:20:21","date_gmt":"2026-04-23T21:20:21","guid":{"rendered":"https:\/\/www.portugalrunning.com\/eventos\/corrida-solidaria-aeisa\/"},"modified":"2026-08-23T21:59:01","modified_gmt":"2026-08-23T20:59:01","slug":"corrida-solidaria-aeisa","status":"publish","type":"ajde_events","link":"https:\/\/www.portugalrunning.com\/eventos\/corrida-solidaria-aeisa\/","title":{"rendered":"Corrida Solid\u00e1ria AEISA 2026"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">A&nbsp;<strong>Associa\u00e7\u00e3o dos Estudantes do Instituto Superior de Agronomia<\/strong>&nbsp;apresenta a \u201cCorrida Solid\u00e1ria AEISA\u201d, a realizar-se no&nbsp;<strong>dia&nbsp;02 de maio de 2026<\/strong>, com o apoio do ISA, CM-Lisboa, Junta de Freguesia de Alc\u00e2ntara, ADESL, FAL, ULisboa e Xistarca.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">A&nbsp;<strong>Associa\u00e7\u00e3o dos Estudantes do Instituto Superior de Agronomia&nbsp;<\/strong>pretende&nbsp;oferecer aos participantes um&nbsp;<strong>percurso desafiante pelos brilhantes cen\u00e1rios<\/strong>&nbsp;que ir\u00e3o encontrar na Tapada da Ajuda e Mata de Monsanto, bem como a oportunidade de contribuir para uma&nbsp;<strong>causa solid\u00e1ria,&nbsp;<\/strong>que apoia este ano a&nbsp;Associa\u00e7\u00e3o de Atividade Motora Adaptada (AAMA).<\/p>\n","protected":false},"author":1,"featured_media":50765,"menu_order":0,"comment_status":"open","ping_status":"closed","template":"","meta":{"_acf_changed":false},"tags":[],"event_type":[672,27,28],"event_type_2":[33,727,820],"event_type_3":[],"event_type_4":[811],"event_type_5":[],"class_list":["post-50764","ajde_events","type-ajde_events","status-publish","has-post-thumbnail","hentry","event_location-monsanto-lisboa","event_type-caminhada","event_type-corrida","event_type-corrida-10-km","event_type_2-lisboa","event_type_2-lisboa-e-centro","event_type_2-portugal","event_type_4-solidarias-sim"],"acf":[],"featured_image_src":"https:\/\/www.portugalru