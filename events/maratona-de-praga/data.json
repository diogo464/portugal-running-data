: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Dist\u00e2ncias<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">42.195 km<\/span><\/li>\n<li class=\"pr-tech-snapshot-item\" style=\"display: flex; flex-direction: column; gap: 4px; width: 100%; min-width: 0; box-sizing: border-box; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 14px 16px;\"><strong class=\"pr-tech-snapshot-label\" style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">Entidade Organizadora<\/strong><span class=\"pr-tech-snapshot-val\" style=\"color: #F8FAFC; font-size: 15px; font-weight: 600; word-break: break-word; overflow-wrap: anywhere; min-width: 0; display: block;\">RunCzech<\/span><\/li>\n<div style=\"grid-column: 1 \/ -1; margin-top: 8px;\"><strong style=\"color: #94A3B8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 10px;\">\ud83c\udfc3 Programa de Provas &#038; Sub-eventos<\/strong><\/p>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;\">\n<div style=\"background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\">\n<div><span style=\"color: #C4B5FD; font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block;\">Maratona<\/span><strong style=\"color: #F8FAFC; font-size: 15px;\">Maratona<\/strong><span style=\"color: #